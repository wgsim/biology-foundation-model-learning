, \"axes.spines.top\": False, \"axes.spines.right\": False})\n\n\ndef find_root():\n    p = Path.cwd().resolve()\n    for q in [p, *p.parents]:\n        if (q / \"SETUP.md\").exists():\n            return q\n    return None\n\n\nROOT = find_root()\nCACHE = (ROOT / \".cache\") if ROOT is not None else Path(\"cache\")\nos.environ.setdefault(\"HF_HOME\", str(CACHE / \"hf\"))\nTEMPLATES = (ROOT / \"06_advanced_research\" / \"templates\") if ROOT is not None else Path(\"templates\")\n\nimport torch\nfrom huggingface_hub import snapshot_download\nfrom transformers import AutoConfig, AutoTokenizer, EsmModel\nfrom transformers.utils import logging as hf_logging\n\nhf_logging.set_verbosity_error()\nhf_logging.disable_progress_bar()\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"mps\" if torch.backends.mps.is_available() else \"cpu\")\nprint(\"device:\", DEVICE, \"| templates:\", TEMPLATES)\nprint({k: md.version(k) for k in [\"numpy\", \"pandas\", \"torch\", \"transformers\", \"peft\"]})","key":"ezrKwCokt9"},{"type":"outputs","id":"_1ElEjNVAjOdJTotj7dyb","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"W1110 13:19:29.276000 11359 torch/distributed/elastic/multiprocessing/redirects.py:35] NOTE: Redirects are currently not supported in MacOs.\n"},"children":[],"key":"KC1U0Xfw2C"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"device: mps | templates: <repo>/06_advanced_research/templates\n{'numpy': '2.5.4', 'pandas': '3.1.1', 'torch': '2.15.0', 'transformers': '5.22.1', 'peft': '0.21.2'}\n"},"children":[],"key":"t6pekvYPIW"}],"key":"GpZOi8djqS"}],"identifier":"cell-001","html_id":"cell-001","key":"OU19ReSVDt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. 어텐션 구현·정밀도·체크포인팅 (측정)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"s1TWk2zp5w"}],"identifier":"id-1","label":"1. 어텐션 구현·정밀도·체크포인팅 (측정)","html_id":"id-1","implicit":true,"key":"aeobkZRuo4"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"입력은 무작위 아미노산 서열(내용은 속도와 무관). 손실은 마지막 층 출력의 제곱 평균(모든 매개변수에 기울기가 흐르게 함). 옵티마이저 스텝은 빼고 forward+backward만 잰다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"iCp7YaYZBu"}],"key":"TnF9AxbhBs"}],"identifier":"cell-002","html_id":"cell-002","key":"SSRUlpy9Xz"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T21:19:29.636052Z","iopub.status.busy":"2026-11-10T21:19:29.635876Z","iopub.status.idle":"2026-11-10T21:20:08.309633Z","shell.execute_reply":"2026-11-10T21:20:08.309238Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"ESM35 = (\"facebook/esm2_t12_35M_UR50D\", \"6fbf070e65b0b7291e7bbcd451118c216cff79d8\")\nD35 = Path(snapshot_download(ESM35[0], revision=ESM35[1], allow_patterns=[\"model.safetensors\", \"*.json\", \"vocab.txt\"]))\nTOK = AutoTokenizer.from_pretrained(D35)\nAA = np.array(list(\"ACDEFGHIKLMNPQRSTVWY\"))\n\n\ndef rand_batch(bs, L, seed=0):\n    rng = np.random.default_rng(seed)\n    seqs = [\"\".join(rng.choice(AA, size=L - 2)) for _ in range(bs)]                # <cls>와 <eos>를 합쳐 길이 L\n    return TOK(seqs, return_tensors=\"pt\")[\"input_ids\"].to(DEVICE)\n\n\ndef sync():\n    if DEVICE.type == \"mps\":\n        torch.mps.synchronize()\n    elif DEVICE.type == \"cuda\":\n        torch.cuda.synchronize()\n\n\ndef bench(impl, precision, ckpt, L, bs=4, reps=3):\n    gc.collect()\n    if DEVICE.type == \"mps\":\n        torch.mps.empty_cache()\n    elif DEVICE.type == \"cuda\":\n        torch.cuda.reset_peak_memory_stats()                                           # (이 Mac에서는 실행되지 않는 경로: 미검증)\n    model = EsmModel.from_pretrained(D35, add_pooling_layer=False, attn_implementation=impl).to(DEVICE).train()\n    if ckpt:\n        model.gradient_checkpointing_enable()\n    ids = rand_batch(bs, L)\n    times = []\n    if DEVICE.type == \"mps\":\n        torch.mps.empty_cache()\n    for r in range(reps + 1):\n        t0 = time.time()\n        if precision == \"bf16\":\n            with torch.autocast(DEVICE.type, dtype=torch.bfloat16):\n                out = model(input_ids=ids, attention_mask=torch.ones_like(ids)).last_hidden_state\n        else:\n            out = model(input_ids=ids, attention_mask=torch.ones_like(ids)).last_hidden_state\n        out.float().pow(2).mean().backward()\n        sync()\n        times.append(time.time() - t0)\n        model.zero_grad(set_to_none=True)\n    mem = torch.mps.driver_allocated_memory() / 1e9 if DEVICE.type == \"mps\" else (torch.cuda.max_memory_allocated() / 1e9 if DEVICE.type == \"cuda\" else np.nan)\n    del model, out\n    gc.collect()\n    if DEVICE.type == \"mps\":\n        torch.mps.empty_cache()\n    return float(np.median(times[1:])), mem\n\n\n# 수치 동등성: sdpa vs eager (fp32, L=256)\nids = rand_batch(4, 256)\nouts = {}\nfor impl in [\"sdpa\", \"eager\"]:\n    m = EsmModel.from_pretrained(D35, add_pooling_layer=False, attn_implementation=impl).to(DEVICE).eval()\n    with torch.no_grad():\n        outs[impl] = m(input_ids=ids, attention_mask=torch.ones_like(ids)).last_hidden_state.float().cpu()\n    del m\nprint(\"sdpa vs eager 마지막 층 출력 최대 절대차(fp32, L=256): %.2e (출력 크기 중앙값 %.2f)\" % ((outs[\"sdpa\"] - outs[\"eager\"]).abs().max().item(), outs[\"sdpa\"].abs().median().item()))\ndel outs, ids                                                                           # 점검에 쓴 버퍼가 첫 측정에 섞이지 않게 비운다\ngc.collect()\nif DEVICE.type == \"mps\":\n    torch.mps.empty_cache()\n\nCONFIGS = {\"sdpa fp32\": (\"sdpa\", \"fp32\", False), \"eager fp32\": (\"eager\", \"fp32\", False), \"sdpa bf16-autocast\": (\"sdpa\", \"bf16\", False), \"sdpa fp32 + 체크포인팅\": (\"sdpa\", \"fp32\", True)}\nLENS = [128, 256, 512, 1024]\nrows = []\nt0 = time.time()\nfor L in LENS:\n    for name, (impl, prec, ck) in CONFIGS.items():\n        try:\n            sec, mem = bench(impl, prec, ck, L)\n        except Exception as e:                                                      # 메모리 부족 등은 기록하고 계속한다\n            sec, mem = np.nan, np.nan\n            print(\"  실패:\", name, L, str(e)[:80])\n        rows.append(dict(길이=L, 설정=name, 초=sec, MPS_드라이버_GB=mem))\n    print(f\"길이 {L} 완료 (누적 {time.time() - t0:.0f}초)\", flush=True)\nBENCH = pd.DataFrame(rows)\nprint(BENCH.pivot(index=\"길이\", columns=\"설정\", values=\"초\").round(2).to_string())\nprint()\nprint(BENCH.pivot(index=\"길이\", columns=\"설정\", values=\"MPS_드라이버_GB\").round(2).to_string())","key":"iewwl9dMbo"},{"type":"outputs","id":"Yey3X8XEuKAbiufz3JkSD","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"sdpa vs eager 마지막 층 출력 최대 절대차(fp32, L=256): 6.20e-06 (출력 크기 중앙값 0.12)\n"},"children":[],"key":"NvtHc6i0xC"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"길이 128 완료 (누적 3초)\n"},"children":[],"key":"hQYImMZQui"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"길이 256 완료 (누적 8초)\n"},"children":[],"key":"Cn5jfppMi5"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"길이 512 완료 (누적 17초)\n"},"children":[],"key":"z4He0OUZS8"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"길이 1024 완료 (누적 38초)\n"},"children":[],"key":"V61NjheXUD"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"설정    eager fp32  sdpa bf16-autocast  sdpa fp32  sdpa fp32 + 체크포인팅\n길이                                                                \n128         0.12                0.12       0.12               0.14\n256         0.17                0.26       0.22               0.23\n512         0.42                0.47       0.47               0.53\n1024        1.04                1.17       1.03               1.38\n\n설정    eager fp3
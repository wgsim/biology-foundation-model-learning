--steps\", str(steps), \"--per-rank-batch\", str(per_rank), \"--out\", str(out), \"--save-params\", str(pnp), *extra]\n    # GPU가 있어도 CPU 2프로세스(gloo)로 확인한다: GPU 1개에서 rank 1이 cuda:1을 열지 못해 실패한다 (Colab T4에서 겪었다)\n    env = dict(os.environ, OMP_NUM_THREADS=\"2\", TOKENIZERS_PARALLELISM=\"false\", CUDA_VISIBLE_DEVICES=\"\")\n    t0 = time.time()\n    r = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=300)\n    if r.returncode != 0:\n        raise RuntimeError(r.stderr[-1500:])\n    return json.loads(out.read_text()), np.load(pnp), time.time() - t0\n\n\nres_init, p_init, _ = run_ddp(1, 16, tag=\"init\", steps=0)             # 0스텝: 초기 매개변수\nres_init2, p_init2, _ = run_ddp(2, 8, tag=\"init2\", steps=0)           # 2프로세스의 초기 매개변수\nres_single, p_single, t1 = run_ddp(1, 16, tag=\"single\")\nres_ddp, p_ddp, t2 = run_ddp(2, 8, tag=\"ddp\")\nres_bad, p_bad, t3 = run_ddp(2, 8, extra=(\"--no-sampler\",), tag=\"nosampler\")\nprint(f\"실행 시간(CPU, 모델 로딩 포함): 단일 {t1:.0f}초 | DDP 2프로세스 {t2:.0f}초 | 샘플러 없음 {t3:.0f}초\")\nprint(\"학습 매개변수 개수:\", p_single.size)\nrows = [\n    dict(실행=\"단일 프로세스 (배치 16)\", 손실=\" \".join(f\"{x:.4f}\" for x in res_single[\"losses\"]), rank_해시_모두_같음=res_single[\"all_ranks_equal\"], 단일_대비_최대절대차=0.0),\n    dict(실행=\"DDP 2프로세스 (rank당 8, 샘플러 사용)\", 손실=\" \".join(f\"{x:.4f}\" for x in res_ddp[\"losses\"]), rank_해시_모두_같음=res_ddp[\"all_ranks_equal\"], 단일_대비_최대절대차=float(np.abs(p_ddp - p_single).max())),\n    dict(실행=\"[음성 대조] DDP 2프로세스, 샘플러 없음\", 손실=\" \".join(f\"{x:.4f}\" for x in res_bad[\"losses\"]), rank_해시_모두_같음=res_bad[\"all_ranks_equal\"], 단일_대비_최대절대차=float(np.abs(p_bad - p_single).max())),\n]\nprint(pd.DataFrame(rows).to_string(index=False))\nprint(\"\\n단일 실행에서 4스텝 동안 학습 매개변수가 움직인 최대 절대량(초기값 대비): %.2e → 위 표의 차이를 이 값과 비교해 읽는다\" % np.abs(p_single - p_init).max())\nprint(\"초기 매개변수: 단일 vs 2프로세스 최대 절대차 %.1e | 2프로세스에서 rank 해시 일치: %s\" % (np.abs(p_init2 - p_init).max(), res_init2[\"all_ranks_equal\"]))\nprint(\"rank별 해시(DDP):\", res_ddp[\"param_hash_per_rank\"])\nprint(\"※ 손실 첫 값은 rank 0의 배치 평균이다. DDP의 rank 0은 샘플 0,2,4,… 8개, 단일은 0..15 16개라 첫 손실 값이 다른 것이 정상이다.\")","key":"rSSrvOguBh"},{"type":"outputs","id":"RCZ1qmrSa7Nobql8abLD9","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"실행 시간(CPU, 모델 로딩 포함): 단일 5초 | DDP 2프로세스 5초 | 샘플러 없음 5초\n학습 매개변수 개수: 61761\n                         실행                          손실  rank_해시_모두_같음  단일_대비_최대절대차\n            단일 프로세스 (배치 16) 1.5608 0.8061 1.2701 0.9814           True 0.000000e+00\nDDP 2프로세스 (rank당 8, 샘플러 사용) 1.0070 1.2782 1.2209 0.8342           True 3.725290e-09\n  [음성 대조] DDP 2프로세스, 샘플러 없음 1.3223 1.7398 1.0848 0.5211           True 4.672986e-04\n\n단일 실행에서 4스텝 동안 학습 매개변수가 움직인 최대 절대량(초기값 대비): 1.32e-02 → 위 표의 차이를 이 값과 비교해 읽는다\n초기 매개변수: 단일 vs 2프로세스 최대 절대차 0.0e+00 | 2프로세스에서 rank 해시 일치: True\nrank별 해시(DDP): ['4d2c2ea2f71ad9e4', '4d2c2ea2f71ad9e4']\n※ 손실 첫 값은 rank 0의 배치 평균이다. DDP의 rank 0은 샘플 0,2,4,… 8개, 단일은 0..15 16개라 첫 손실 값이 다른 것이 정상이다.\n"},"children":[],"key":"FVIp8niUWL"}],"key":"o3q2S62pUI"}],"identifier":"cell-007","html_id":"cell-007","key":"k6W5dT7C3a"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"정리","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zPDEDDoqSj"}],"identifier":"id","label":"정리","html_id":"id","implicit":true,"key":"iWhqZnlaLY"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"(실행 결과를 확인한 뒤 README §5에서 수치와 함께 해석한다. 이 노트북은 Mac MPS 한 대의 측정, 공식에 의한 메모리 하한, CPU gloo 2프로세스의 동작 점검이다. ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"vXzeGiVbdg"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"GPU 클러스터·NCCL·다중 노드·FSDP/ZeRO는 실행하지 못했다.","position":{"start":{"line":2,"column"
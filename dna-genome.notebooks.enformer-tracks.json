"line":10,"column":1},"end":{"line":10,"column":1}},"key":"htzLsn7bGc"},{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"중앙 896 bins(128 bp 단위, 약 114,688 bp)","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"g2PVhSJ7RL"}],"key":"SkO9XnWG0k"},{"type":"text","value":" × 사람 5,313 트랙 (DNase/ATAC, 히스톤·TF ChIP, CAGE).\n이것은 DNA 언어모델이 아니라 ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"UwnEcPAx37"},{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"실험 트랙을 직접 예측하도록 지도학습","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"BwS2Uyyyne"}],"key":"LsLcJHdawJ"},{"type":"text","value":"된 모델이다 (강의노트 2.2).","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"tJ7cRQbbdP"}],"key":"AfDkQzHQk1"}],"identifier":"cell-000","html_id":"cell-000","key":"DywemoSPK6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nimport warnings\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\nwarnings.filterwarnings(\"ignore\")\n\n\ndef find_root():\n    p = Path.cwd().resolve()\n    for q in [p, *p.parents]:\n        if (q / \"SETUP.md\").exists():\n            return q\n    return None\n\n\nROOT = find_root()\nif ROOT is not None:\n    os.environ.setdefault(\"HF_HOME\", str(ROOT / \".cache\" / \"hf\"))\nos.environ.setdefault(\"PYTORCH_ENABLE_MPS_FALLBACK\", \"1\")           # MPS에서 미지원 연산은 CPU로 대체\nTARGETS = (ROOT / \".cache\" / \"enformer\" / \"targets_human.txt\") if ROOT else Path(\"targets_human.txt\")\n\nimport json\nimport time\nimport urllib.request\n\nimport matplotlib.pyplot as plt\nimport torch\nimport transformers\nfrom enformer_pytorch import Enformer, str_to_one_hot\n\nprint(\"transformers\", transformers.__version__, \"| torch\", torch.__version__)\nassert transformers.__version__.startswith(\"4.\"), \"격리 환경(.venv-enformer)에서 실행하세요 — 위 안내 참고\"\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"mps\" if torch.backends.mps.is_available() else \"cpu\")\nprint(\"device:\", DEVICE)","key":"C9b73Dip97"},{"type":"outputs","id":"Cbxszl9yjDlHGXMmDgUPp","children":[],"key":"ijeHR29rEX"}],"identifier":"cell-001","html_id":"cell-001","key":"rWYcgkVYXU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. 유전자 TSS와 196,608 bp 서열 가져오기","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KaSJKkyOnH"}],"identifier":"id-1-tss-196-608-bp","label":"1. 유전자 TSS와 196,608 bp 서열 가져오기","html_id":"id-1-tss-196-608-bp","implicit":true,"key":"w3YKSHoyB3"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"UCSC 유전체 브라우저 REST API (","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"dNG0oPpTiY"},{"type":"inlineCode","value":"api.genome.ucsc.edu","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"GnAVWs8inZ"},{"type":"text","value":")에서 (1) hg38 RefSeq Select 주석으로 ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"RA7aEmkVj1"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"GAPDH","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"HcttSOnEez"}],"key":"Mm1OdbKps1"},{"type":"text","value":"의 전사 시작 좌표를, (2) 그 주변 서열을 조회한다.\nGAPDH는 널리 발현되는 관리(housekeeping) 유전자라 대부분 세포에서 TSS 주변에 강한 프로모터 신호가 기대된다. 그래서 정합성 점검에 쓰기 좋다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ZAGknIMKTw"}],"key":"e2Jfn4nwCz"}],"identifier":"cell-002","html_id":"cell-002","key":"VfJXofBmom"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"UCSC = \"https://api.genome.ucsc.edu/getData\"\n\n\ndef ucsc_get(url):\n    with urllib.request.urlopen(url, timeout=60) as r:\n        return json.load(r)\n\n\nann = ucsc_get(f\"{UCSC}/track?genome=hg38;track=ncbiRefSeqSelect;chrom=chr12;start=6530000;end=6545000\")[\"ncbiRefSeqSelect\"]\ngapdh = [g for g in ann if g[\"name2\"] == \"GAPDH\"][0]\nprint({k: gapdh[k] for k in [\"name\", \"name2\", \"chrom\", \"strand\", \"txStart\", \"txEnd\"]})\nassert gapdh[\"strand\"] == \"+\", \"이 노트북은 + 가닥 유전자를 가정\"\nTSS0 = gapdh[\"txStart\"]                    # 0-based. UCSC txStart는 전사 시작 위치 (+ 가닥)\nCHROM, L_IN = gapdh[\"chrom\"], 196_608\nSTART = TSS0 - L_IN // 2\nCHUNK = 50_000\nparts = []\nfor s in range(START, START + L_IN, CHUNK):\n    e = min(s + CHUNK, START + L_IN)\n    parts.append(ucsc_get(f\"{UCSC}/sequence?genome=hg38;chrom={CHROM};start={s};end={e}\")[\"dna\"])\nSEQ = \"\".join(parts).upper()\nprint(f\"{CHROM}:{START:,}-{START + L_IN:,} ({len(SEQ):,} bp) | N 개수: {SEQ.count('N')} | TSS(0-based) {TSS0:,} 는 입력의 {TSS0 - START:,}번째 염기\")\nassert len(SEQ) == L_IN","key":"E4mNnc4qUl"},{"type":"outputs","id":"pXJIBN95G8DNOEqHM71Tq","children":[],"key":"TUpQIYvP02"}],"identifier":"cell-003","html_id":"cell-003","key":"OqwtKDCM1f"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. 모델과 트랙 선택","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XgHcQ5UFm2"}],"identifier":"id-2","label":"2. 모델과 트랙 선택","html_id":"id-2","implicit":true,"key":"c0komjZ2Zm"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"트랙 메타데이터는 Calico Basenji 저장소의 ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"XDKfVi03G7"},{"type":"inlineCode","value":"targets_human.txt","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"gh21d9zfCw"},{"type":"text","value":"(5,313행)다. K562(만성골수성백혈병 세포주)의 트랙 몇 개를 고른다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"eMlWKy6BLi"}],"key":"uUVbaVgBGs"}],"identifier":"cell-004","html_id":"cell-004","key":"gKLGIeykZ6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"model = Enformer.from_pretrained(\"EleutherAI/enformer-official-rough\").to(DEVICE).eval()\nprint(\"params (M):\", round(sum(p.numel() for p in model.parameters()) / 1e6))\n\nTARGETS_URL = \"https://raw.githubusercontent.com/calico/basenji/master/manuscripts/cross2020/targets_human.txt\"      # 0.8 MB (Calico Basenji 저장소)\nif not TARGETS.exists():\n    TARGETS.parent.mkdir(parents=True, exist_ok=True)\n    print(\"downloading\", TARGETS_URL)\n    urllib.request.urlretrieve(TARGETS_URL, TARGETS)\ntg = pd.read_csv(TARGETS, sep=\"\\t\")\ntg[\"kind\"] = tg.description.str.split(\":\").str[0]\nprint(tg.kind.value_counts().to_dict(), \"| 합계\", len(tg))\npick = {}\npick[\"CAGE K562\"] = int(tg[(tg.kind == \"CAGE\") & tg.description.str.contains(\"K562\")].index[0])\npick[\"DNase K562\"] = int(tg[tg.description == \"DNASE:K562\"].index[0])\npick[\"H3K4me3 K562\"] = int(tg[tg.description == \"CHIP:H3K4me3:K562\"].index[0])\npick[\"H3K27me3 K562\"] = int(tg[tg.description == \"CHIP:H3K27me3:K562\"].index[0])\npick[\"CTCF K562\"] = int(tg[tg.description == \"CHIP:CTCF:K562\"].index[0])\nfor k, i in pick.items():\n    print(f\"{k:14s} 트랙 {i:5d} | {tg.description[i]}\")","key":"j1J83Fn2H3"},{"type":"outputs","id":"HW1uGcX6BwEZYw1g_2NJN","children":[],"key":"PKMvx7sBTx"}],"identifier":"cell-005","html_id":"cell-005","key":"jrrwfT3FR9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. 예측","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LBNKlPB3DE"}],"identifier":"id-3","label":"3. 예측","html_id":"id-3","implicit":true,"key":"pM8SAl1s5f"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"입력은 one-hot(A,C,G,T; N은 모두 0). 출력 ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Pm7hcZiCP0"},{"type":"inlineCode","value":"(1, 896, 5313)","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ti6Vjk35UQ"},{"type":"text","value":"은 ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"UE27U1LGp2"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"입력 중앙 114,688 bp","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"gJD54ZvP7f"}],"key":"JOUoBHMAi1"},{"type":"text","value":"에 해당하는 128 bp bin별 예측이다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"pB4Xh3Dugn"}],"key":"Dx6IipEzox"}],"identifier":"cell-006","html_id":"cell-006","key":"PbvjWaQFJw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"@torch.no_grad()\ndef predict(seq):\n    x = str_to_one_hot([seq]).to(DEVICE)\n    out = model(x, head=\"human\")\n    if DEVICE.type == \"mps\":\n        torch.mps.synchronize()\n    return out[0].float().cpu().numpy()                     # (896, 5313)\n\n\nt0 = time.time()\npred = predict(SEQ)\nprint(\"출력 shape:\", pred.shape, f\"| {time.time() - t0:.1f}s (첫 호출)\")\nt0 = time.time()\npred = predict(SEQ)\nT_FWD = time.time() - t0\nprint(f\"두 번째 호출: {T_FWD:.1f}s\")\n\nN_BINS, BIN = pred.shape[0], 128\nbin_of_tss = (TSS0 - START - (L_IN - N_BINS * BIN) // 2) // BIN         # TSS가 속하는 출력 bin\n# 확인: TSS − START − 40,960(왼쪽 잘리는 부분) = 57,344 = 448 × 128, 나머지 0이므로 TSS는 bin 448의 **첫 번째 염기**다 (bin 448 = TSS 기준 [0, +128) bp).\nprint(\"TSS가 속하는 출력 bin:\", bin_of_tss, \"(전체 0~895, 중앙은 448)\")","key":"zdDww6PPoo"},{"type":"outputs","id":"5_k3dR5XS0mKWUvkNrgP5","children":[],"key":"wDnz6TM8UH"}],"identifier":"cell-007","html_id":"cell-007","key":"HOCmR0fhLG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. 트랙 그리기","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mMCFxHJ8uI"}],"identifier":"id-4","label":"4. 트랙 그리기","html_id":"id-4","implicit":true,"key":"SNCehAoQKs"}],"identifier":"cell-008","html_id":"cell-008","key":"lC1EHnpv8b"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x_kb = (np.arange(N_BINS) * BIN + BIN / 2 + (L_IN - N_BINS * BIN) // 2 + START - TSS0) / 1000      # bin 중심 좌표 (TSS 기준)\nfig, axes = plt.subplots(len(pick), 1, figsize=(9, 8), sharex=True)\nfor ax, (name, i) in zip(axes, pick.items()):\n    ax.fill_between(x_kb, pred[:, i], step=\"mid\", lw=0)\n    ax.axvline(0, color=\"r\", lw=0.8)\n    ax.set_ylabel(name, rotation=0, ha=\"right\", fontsize=8)\naxes[-1].set_xlabel(\"TSS 기준 거리 (kb), 빨간 선 = GAPDH TSS\")\naxes[0].set_title(f\"Enformer 예측: {CHROM}, GAPDH 주변\")\nplt.tight_layout()\nplt.show()","key":"nW0BCIR7Uw"},{"type":"outputs","id":"eaykTA-DPYYEkAhI5jf3o","children":[],"key":"dHGPJo3mds"}],"identifier":"cell-009","html_id":"cell-009","key":"SjRua1yA2Z"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. 정합성 점검 — 숫자로 확인하기","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pSTdt0ik1d"}],"identifier":"id-5","label":"5. 정합성 점검 — 숫자로 확인하기","html_id":"id-5","implicit":true,"key":"djzy6buTly"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"(1) ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"lu85VXr3qs"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"TSS 근처 vs 평균","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"c2kMIuXJTW"}],"key":"lsO4kwXmsQ"},{"type":"text","value":": 중앙 ±2 bin의 평균 예측 ÷ 전체 896 bin 평균 (K562 CAGE·DNase·H3K4me3).\n(2) ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ShAIoIlNpn"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"음성 대조","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"oA0EBSZ4UI"}],"key":"cjkBkG6tSC"},{"type":"text","value":": 같은 서열을 ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"nfEIeCRknk"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"무작위로 섞어","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"aAOsVGHkaH"}],"key":"rtQGccufLG"},{"type":"text","value":"(염기 조성은 같고 구조는 파괴) 같은 점검을 반복해, 신호가 사라지는지 본다.\n(3) ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"RlxgPqBbR3"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"전체 CAGE 트랙 638개","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"avXB37obQM"}],"key":"l1y2GNU9Gp"},{"type":"text","value":"에서 TSS 근처 신호가 평균보다 높은 트랙의 비율.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"md8sELFf4G"}],"key":"gdpVnAcGz9"}],"identifier":"cell-010","html_id":"cell-010","key":"qPujOtir1D"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"N_SHUF = 5\npred_shufs = [predict(\"\".join(np.random.RandomState(sd).permutation(list(SEQ)))) for sd in range(N_SHUF)]      # 서로 다른 시드로 5번 섞음\n\n\ndef center_ratio(p, i, half=2):\n    c = slice(bin_of_tss - half, bin_of_tss + half + 1)\n    return p[c, i].mean() / (p[:, i].mean() + 1e-9)\n\n\nprint(f\"{'트랙':14s}{'원래 서열':>12s}{'섞은 서열(5회 평균 ± SD)':>28s}\")\nfor name, i in pick.items():\n    if name in (\"H3K27me3 K562\", \"CTCF K562\"):\n        continue\n    r_s = [center_ratio(q, i) for q in pred_shufs]\n    print(f\"{name:14s}{center_ratio(pred, i):12.2f}{np.mean(r_s):17.2f} ± {np.std(r_s):.2f}\")\n\ncage_idx = tg.index[tg.kind == \"CAGE\"].values\nr_orig = np.array([center_ratio(pred, i) for i in cage_idx])\nr_shuf = np.array([[center_ratio(q, i) for i in cage_idx] for q in pred_shufs])        # (5, 638)\nprint(f\"\\nCAGE 트랙 {len(cage_idx)}개 전체에 대해 (TSS 근처 ÷ 평균):\")\nprint(f\"  '1보다 큰' 트랙 비율 — 원래 {np.mean(r_orig > 1):.2f} | 섞은 서열 {np.mean(r_shuf > 1):.2f}   ← 섞은 서열에서도 높다면 이 지표는 구분력이 없다\")\nprint(f\"  비율의 중앙값 — 원래 {np.median(r_orig):.1f} | 섞은 서열 {np.median(r_shuf):.1f} (5회: {np.round(np.median(r_shuf, axis=1), 1).tolist()})\")\nprint(f\"  원래 서열의 비율이 섞은 서열보다 큰 트랙 비율: {np.mean(r_orig[None] > r_shuf):.2f}\")\nall_c = slice(bin_of_tss - 2, bin_of_tss + 3)\nprof = [float(np.median(q[all_c].mean(0) / (q.mean(0) + 1e-9))) for q in pred_shufs]\nprint(f\"섞은 서열 입력에서 5,313개 전체 트랙의 중앙 비율 중앙값(5회): {np.round(prof, 2).tolist()}  ← 1보다 크면 서열 정보와 무관하게 중앙이 높게 예측되는 경향 (위치 편향 가설)\")\nprint(\"\\nISM에서 쓸 TSS 근처 서열(TSS-35 ~ TSS+10, 5'→3'):\", SEQ[TSS0 - START - 35:TSS0 - START + 10])\npeak_bin = bin_of_tss - 10 + int(np.argmax(pred[bin_of_tss - 10:bin_of_tss + 11, pick[\"CAGE K562\"]]))\nprint(f\"K562 CAGE 예측의 TSS ±10 bin 내 최대 위치: TSS에서 {(peak_bin - bin_of_tss) * BIN:+d} bp (bin 해상도 {BIN} bp)\")","key":"HGETGRB3YG"},{"type":"outputs","id":"6DKOVY_6G8BP5VrXY3W-K","children":[],"key":"Na5LB00n5v"}],"identifier":"cell-011","html_id":"cell-011","key":"r2ctVSU4UK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. In silico mutagenesis (ISM)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QjgSLQXixK"}],"identifier":"id-6-in-silico-mutagenesis-ism","label":"6. In silico mutagenesis (ISM)","html_id":"id-6-in-silico-mutagenesis-ism","implicit":true,"key":"CRPHBUJpEb"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"서열의 한 염기를 다른 염기로 바꿔 K562 CAGE 예측(TSS ±2 bin 평균)이 얼마나 변하는지 본다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"cvLrsFwleY"}],"key":"TJjDtTk1sD"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"가까운 위치","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XgtOZAgbU5"}],"key":"KvrjqBIQlW"},{"type":"text","value":": TSS 근처 (TSS −30 ~ +30 bp, 5 bp 간격)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BnTw6n0xSH"}],"key":"yFWqjSa4Zz"}],"key":"pPfRdMh8NJ"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"먼 위치","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"nUChGfsShE"}],"key":"J6TficmYKe"},{"type":"text","value":": TSS에서 +40 kb 떨어진 같은 개수의 위치 (출력 구간 안)\n각 위치에서 나머지 3개 염기로 바꿔 예측하므로 forward가 (위치 수 × 3)번 필요하다.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"L2F1dcvdWX"}],"key":"vtvdrdx9co"}],"key":"AUwbhKcMTJ"}],"key":"xFd646KeHc"}],"identifier":"cell-012","html_id":"cell-012","key":"OmweuXdwWz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"NEAR = np.arange(-30, 31, 5)\nFAR = 40_000 + np.arange(-30, 31, 5)\ncage_i = pick[\"CAGE K562\"]\nbase_val = pred[bin_of_tss - 2:bin_of_tss + 3, cage_i].mean()\n\n\ndef ism(offsets):\n    \"\"\"열 = A, C, G, T 고정. ref 염기와 같은 칸은 NaN.\"\"\"\n    out = np.full((len(offsets), 4), np.nan)\n    for r, off in enumerate(offsets):\n        p = TSS0 - START + int(off)\n        for c, a in enumerate(\"ACGT\"):\n            if a == SEQ[p]:\n                continue\n            q = predict(SEQ[:p] + a + SEQ[p + 1:])\n            out[r, c] = q[bin_of_tss - 2:bin_of_tss + 3, cage_i].mean() - base_val\n    return out\n\n\nt0 = time.time()\nd_near = ism(NEAR)\nd_far = ism(FAR)\nprint(f\"ISM 완료: 예측 {2 * len(NEAR) * 3}회, {time.time() - t0:.0f}s (예측 1회 약 {T_FWD:.1f}s)\")\nprint(f\"기준 예측값(K562 CAGE, TSS ±2 bin 평균): {base_val:.3f}\")\nprint(f\"|Δ| 평균 — 가까운 위치(±30 bp): {np.nanmean(np.abs(d_near)):.4f} | 먼 위치(+40 kb): {np.nanmean(np.abs(d_far)):.4f} | 비율 {np.nanmean(np.abs(d_near)) / (np.nanmean(np.abs(d_far)) + 1e-12):.1f}배\")\nr_max = np.unravel_index(np.nanargmax(np.abs(d_near)), d_near.shape)\nprint(f\"|Δ| 최대 — 가까운 위치: {np.nanmax(np.abs(d_near)):.4f} (TSS{NEAR[r_max[0]]:+d} bp, {SEQ[TSS0 - START + int(NEAR[r_max[0]])]}→{'ACGT'[r_max[1]]}) | 먼 위치: {np.nanmax(np.abs(d_far)):.4f}\")","key":"UmNZEyg6q9"},{"type":"outputs","id":"ZldJ6L9-eSSRWZGSXTk7S","children":[],"key":"VqgU7BBpAf"}],"identifier":"cell-013","html_id":"cell-013","key":"Xf1tDri6iG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"vmax = np.nanmax(np.abs(d_near))\nfig, ax = plt.subplots(1, 2, figsize=(10, 3), sharey=True)\nfor a, d, offs, title in [(ax[0], d_near, NEAR, \"TSS 근처 (±30 bp)\"), (ax[1], d_far, FAR, \"먼 위치 (+40 kb)\")]:\n    im = a.imshow(np.ma.masked_invalid(d.T), aspect=\"auto\", cmap=\"coolwarm\", vmin=-vmax, vmax=vmax)\n    a.set_xticks(range(len(offs)))\n    a.set_xticklabels([f\"{o}\\n{SEQ[TSS0 - START + int(o)]}\" for o in offs], fontsize=7)       # 위치와 ref 염기\n    a.set_yticks(range(4))\n    a.set_yticklabels(list(\"ACGT\"))\n    a.set_title(title, fontsize=9)\n    a.set_xlabel(\"TSS 기준 위치 (bp) / ref 염기\")\nax[0].set_ylabel(\"alt 염기 (ref와 같은 칸은 비워 둠)\")\nplt.colorbar(im, ax=ax, fraction=0.03)\nplt.show()","key":"WbheMYGcy7"},{"type":"outputs","id":"Mie4xADArnFo0jWYBvK0F","children":[],"key":"J9R0Pyn7vB"}],"identifier":"cell-014","html_id":"cell-014","key":"MNmc1umtLl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"7. 해석 가이드와 한계","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ooMxRmAsio"}],"identifier":"id-7","label":"7. 해석 가이드와 한계","html_id":"id-7","implicit":true,"key":"KGtTKt4jvn"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"이 실행(MPS)에서 읽은 내용이다. ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SVxkvojC32"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"숫자는 직접 다시 확인한다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ImlStRnrZs"}],"key":"aTWNq4IUWZ"}],"key":"gMbBPakOgD"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":4,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},
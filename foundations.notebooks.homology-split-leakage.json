ate([np.concatenate(pooled[k][0]) for k in GROUPS])\nall_mx = np.concatenate([np.concatenate(pooled[k][1]) for k in GROUPS])\nall_accs = []\nfor lo, hi in zip(bins[:-1], bins[1:]):\n    sel = (all_mx >= lo) & (all_mx < hi)\n    all_accs.append(all_correct[sel].mean() if sel.sum() >= 20 else np.nan)\naxes[1].plot(range(len(labels)), all_accs, color=\"k\", lw=2.5, marker=\"s\", label=\"all splits pooled\")\nprint(\"전체 합친 구간별 정확도:\", dict(zip(labels, np.round(all_accs, 3))))\naxes[0].set_xlabel(\"max identity to train\")\naxes[0].set_ylabel(\"# test sequences\")\naxes[0].legend()\naxes[1].set_xticks(range(len(labels)))\naxes[1].set_xticklabels(labels, rotation=30)\naxes[1].set_ylabel(\"accuracy\")\naxes[1].set_xlabel(\"max identity to train (bins)\")\naxes[1].legend()\nplt.tight_layout()\nplt.show()","key":"Zhzgo4sllP"},{"type":"outputs","id":"Ja4B5IHRgkM9kYC5dUSmH","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"random             구간별 n(5회 반복 평가 건수의 합, 고유 서열 수 아님): {'0.00-0.15': 0, '0.15-0.25': 0, '0.25-0.40': 0, '0.40-0.60': 24, '0.60-1.01': 3576}\nfamily             구간별 n(5회 반복 평가 건수의 합, 고유 서열 수 아님): {'0.00-0.15': 55, '0.15-0.25': 1465, '0.25-0.40': 2080, '0.40-0.60': 0, '0.60-1.01': 0}\ncluster(0.20)      구간별 n(5회 반복 평가 건수의 합, 고유 서열 수 아님): {'0.00-0.15': 3181, '0.15-0.25': 719, '0.25-0.40': 0, '0.40-0.60': 0, '0.60-1.01': 0}\nsuperfamily(true)  구간별 n(5회 반복 평가 건수의 합, 고유 서열 수 아님): {'0.00-0.15': 2847, '0.15-0.25': 753, '0.25-0.40': 0, '0.40-0.60': 0, '0.60-1.01': 0}\n전체 합친 구간별 정확도: {'0.00-0.15': np.float64(0.792), '0.15-0.25': np.float64(0.799), '0.25-0.40': np.float64(0.844), '0.40-0.60': np.float64(0.875), '0.60-1.01': np.float64(0.91)}\n"},"children":[],"key":"k93ZoewKje"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"7350902e99464858158a1ae581eeddba","path":"/biology-foundation-model-learning/_public/7350902e99464858158a1ae581eeddba.png"
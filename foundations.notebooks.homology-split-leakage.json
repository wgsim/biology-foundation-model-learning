"text","value":"로 분할. 동일도 클러스터링이 이 정답에 얼마나 근접한지 비교하는 기준이다 (실제 데이터에는 이 정답이 없다).","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"lm4ffPKkE8"}],"key":"UKZg7XHyNu"}],"key":"fkTCqA9p7h"}],"key":"PvKc4sGDcz"}],"identifier":"cell-005","html_id":"cell-005","key":"hRa1vnMPwr"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:42:50.841481Z","iopub.status.busy":"2026-11-10T19:42:50.841379Z","iopub.status.idle":"2026-11-10T19:42:50.871427Z","shell.execute_reply":"2026-11-10T19:42:50.870888Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def kmer_counts(X, k=3):\n    N, Ln = X.shape\n    idx = sum(X[:, i:Ln - k + 1 + i] * (V ** (k - 1 - i)) for i in range(k))\n    rows = np.repeat(np.arange(N), idx.shape[1])\n    M = sparse.csr_matrix((np.ones(idx.size), (rows, idx.ravel())), shape=(N, V ** k))\n    return M / idx.shape[1]\n\n\nF = kmer_counts(X)\nprint(\"feature matrix:\", F.shape)\n\nn_cl, cluster020 = cluster_by_identity(0.20)\nprint(\"clusters at identity >= 0.20:\", n_cl)\nGROUPS = {\"random\": None, \"family\": fam, \"cluster(0.20)\": cluster020, \"superfamily(true)\": sup}\n\n\ndef split_indices(kind, seed, test_size=0.3):\n    n = len(X)\n    if kind == \"random\":\n        r = np.random.RandomState(seed)\n        perm = r.permutation(n)\n        k = int(n * (1 - test_size))\n        return perm[:k], perm[k:]\n    gss = GroupShuffleSplit(n_splits=1, test_size=test_size, random_state=seed)\n    return next(gss.split(F, y, GROUPS[kind]))\n\n\ndef run(kind, seed):\n    tr, te = split_indices(kind, seed)\n    if len(set(y[tr])) < 2 or len(set(y[te])) < 2:\n        return None          # 한 클래스뿐이면 AUROC가 정의되지 않으므로 이 split은 버리고 다음 시드로 대체한다\n    clf = LogisticRegression(max_iter=3000, C=50.0).fit(F[tr], y[tr])\n    p = clf.predict_proba(F[te])[:, 1]\n    max_id = IDENT[np.ix_(te, tr)].max(axis=1)         # 각 테스트 서열의 훈련 세트 최대 동일도\n    return roc_auc_score(y[te], p), (p > 0.5) == y[te], max_id","key":"XN8u98WD9f"},{"type":"outputs","id":"X9XHNo5Sg7ZBY-LrhdFFV","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"feature matrix: (2400, 8000)\nclusters at identity >= 0.20: 37\n"},"children":[],"key":"S1x0Jpeq3k"}],"key":"TWFLgZ07td"}],"identifier":"cell-006","html_id":"cell-006","key":"Vqsv3A3RW8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. 결과 — AUROC (시드 5회)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qqWQsPvmP1"}],"identifier":"id-3-auroc-5","label":"3. 결과 — AUROC (시드 5회)","html_id":"id-3-auroc-5","implicit":true,"key":"xhesmUSc0Y"}],"identifier":"cell-007","html_id":"cell-007","key":"O1plZrZL4u"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:42:50.872706Z","iopub.status.busy":"2026-11-10T19:42:50.872631Z","iopub.status.idle":"2026-11-10T19:42:51.360228Z","shell.execute_reply":"2026-11-10T19:42:51.359740Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"N_REP = 5\nres = {k: [] for k in GROUPS}\npooled = {k: ([], []) for k in GROUPS}       # (정답 여부, 최대 동일도) — 반복 평가를 이어붙인 것\nskipped = {k: 0 for k in GROUPS}\nfor kind in GROUPS:\n    sd, got = 0, 0\n    while got < N_REP and sd < 100:\n        out = run(kind, sd)\n        sd += 1\n        if out is None:\n            skipped[kind] += 1\n            continue\n        auc, correct, max_id = out\n        res[kind].append(auc)\n        pooled[kind][0].append(correct)\n        pooled[kind][1].append(max_id)\n        got += 1\nfor kind, v in res.items():\n    print(f\"{kind:18s} AUROC {np.mean(v):.3f} ± {np.std(v):.3f}   (시드별: {np.round(v, 3)})   버려진 split: {skipped[kind]}\")\n\nfig, ax = plt.subplots(figsize=(4.5, 3))\nax.bar(list(res), [np.mean(v) for v in res.values()], yerr=[np.std(v) for v in res.val
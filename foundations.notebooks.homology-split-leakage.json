   return seq\n\n\nX, y, fam, sup = [], [], [], []\nfor s in range(N_SUPER):\n    anc = rs.randint(0, V, L)\n    has_motif = rs.rand() < 0.5\n    is_signal = rs.rand() < 0.7\n    label = int(has_motif) if is_signal else int(rs.rand() < 0.5)\n    for f in range(N_FAM):\n        fam_anc = mutate(anc, 0.5, rs)\n        if has_motif:\n            fam_anc = insert_motif(fam_anc, rs)\n        for _ in range(N_MEM):\n            X.append(mutate(fam_anc, rs.uniform(0.05, 0.30), rs))\n            y.append(label)\n            fam.append(s * N_FAM + f)\n            sup.append(s)\nX, y, fam, sup = np.array(X), np.array(y), np.array(fam), np.array(sup)\nprint(X.shape, \"positives:\", y.mean().round(2), \"| families:\", len(set(fam)), \"| superfamilies:\", len(set(sup)))","key":"FkzappKO8w"},{"type":"outputs","id":"5_pmzIFa5OY9qYLRayDNa","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"(2400, 100) positives: 0.48 | families: 200 | superfamilies: 40\n"},"children":[],"key":"X3t3kTAL1F"}],"key":"LExUCXJQCT"}],"identifier":"cell-001","html_id":"cell-001","key":"mG5ZhHpG5K"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. 서열 동일도와 클러스터링","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"igSTpPV2KM"}],"identifier":"id-1","label":"1. 서열 동일도와 클러스터링","html_id":"id-1","implicit":true,"key":"ikaa8QepR2"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"치환만 있으므로 같은 길이의 서열은 위치별 일치 비율(Hamming 동일도)로 비교할 수 있다. 원-핫 행렬 곱으로 한 번에 계산한다.\n(실제 데이터에서는 정렬이 필요하므로 MMseqs2 같은 도구를 쓴다.)","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"JgOntKeYYB"}],"key":"Sbb4tYtkT6"}],"identifier":"cell-002","html_id":"cell-002","key":"Py3AwjK7KZ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:42:50.629614Z","iopub.status.busy":"2026-11-10T19:42:50.629476Z","iopub.status.idle":"2026-11-10T19:42:50.839995Z","shell.execute_reply":"2026-11-10T19:42:50.839568Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"onehot = np.zeros((X.shape[0], L * V), dtype=np.float32)\nonehot[np.arange(X.shape[0])[:, None], np.arange(L)[None, :] * V + X] = 1.0\nIDENT = onehot @ onehot.T / L\nnp.fill_diagonal(IDENT, 0)\n\n\ndef same(a, b):\n    return a[:, None] == b[None, :]\n\n\niu = np.triu_indices(len(X), 1)\npair_ident = IDENT[iu]\nfor name, mask in [(\"같은 가족\", same(fam, fam)[iu]),\n                   (\"같은 슈퍼패밀리, 다른 가족\", (same(sup, sup) & ~same(fam, fam))[iu]),\n                   (\"다른 슈퍼패밀리\", ~same(sup, sup)[iu])]:\n    q = np.percentile(pair_ident[mask], [5, 50, 95])\n    print(f\"{name:24s} 동일도 5/50/95%: {q[0]:.2f} / {q[1]:.2f} / {q[2]:.2f}\")\n\n\ndef cluster_by_identity(thr):\n    adj = sparse.csr_matrix(IDENT >= thr)\n    n, labels = connected_components(adj, directed=False)\n    return n, labels\n\n\nfor thr in [0.5, 0.3, 0.25, 0.2, 0.15]:\n    n, _ = cluster_by_identity(thr)\n    print(f\"동일도 ≥ {thr:.2f} 단일 연결 클러스터 수: {n}\")","key":"AxQC9lRnIH"},{"type":"outputs","id":"UsCdyJpVHbQ_gVS-oES7w","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"같은 가족                    동일도 5/50/95%: 0.54 / 0.69 / 0.85\n같은 슈퍼패밀리, 다른 가족          동일도 5/50/95%: 0.13 / 0.20 / 0.28\n다른 슈퍼패밀리                 동일도 5/50/95%: 0.02 / 0.05 / 0.09\n동일도 ≥ 0.50 단일 연결 클러스터 수: 200\n동일도 ≥ 0.30 단일 연결 클러스터 수: 133\n동일도 ≥ 0.25 단일 연결 클러스터 수: 47\n동일도 ≥ 0.20 단일 연결 클러스터 수: 37\n"},"children":[],"key":"r5MAKkgkZB"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"동일도 ≥ 0.15 단일 연결 클러스터 수: 1\n"},"children":[],"key":"whzA6h2ybz"}],"key":"PajPygyz8i"}],"identifier":"cell-003","html_id":"cell-003","key":"TRSpsnQlmc"},{"type":"block","kind":"notebook-content","children":[{"type":"paragr
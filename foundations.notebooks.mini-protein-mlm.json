atus.busy":"2026-11-10T19:42:35.216973Z","iopub.status.idle":"2026-11-10T19:42:45.638845Z","shell.execute_reply":"2026-11-10T19:42:45.638271Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"@torch.no_grad()\ndef acc_with_partner(model, X, target, partner, mode, bs=1000, seed=0):\n    model.eval()\n    g = np.random.RandomState(seed)\n    Xt = torch.from_numpy(X).long().to(DEVICE)\n    correct = 0\n    for st in range(0, Xt.size(0), bs):\n        x = Xt[st:st + bs].clone()\n        y = x[:, target].clone()\n        x[:, target] = MASK_ID\n        if mode == \"shuffle\":\n            x[:, partner] = torch.from_numpy(g.choice(V, size=x.size(0), p=background)).long().to(DEVICE)\n        elif mode == \"mask\":\n            x[:, partner] = MASK_ID\n        correct += (model(x)[:, target].argmax(-1) == y).sum().item()\n    return correct / Xt.size(0)\n\n\ntargets = np.array([t for t, _ in directed])\nfor mode, name in [(\"none\", \"(a) 파트너 그대로\"), (\"shuffle\", \"(b) 파트너 무작위 교체\"), (\"mask\", \"(c) 파트너도 마스킹\")]:\n    accs = np.array([acc_with_partner(model, X_test, t, pr, mode) for t, pr in directed])\n    print(f\"{name:22s} 평균 정확도 {accs.mean():.3f}   (같은 target들의 위치별 최빈값 baseline {base_acc[targets].mean():.3f})\")","key":"K6okx6jFeA"},{"type":"outputs","id":"NienduL_HzE6AJ892HPTK","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"(a) 파트너 그대로            평균 정확도 0.907   (같은 target들의 위치별 최빈값 baseline 0.129)\n"},"children":[],"key":"n7z6zWJC3v"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"(b) 파트너 무작위 교체         평균 정확도 0.063   (같은 target들의 위치별 최빈값 baseline 0.129)\n"},"children":[],"key":"zjbIHzk8md"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"(c) 파트너도 마스킹           평균 정확도 0.127   (같은 target들의 위치별 최빈값 baseline 0.129)\n"},"children":[],"key":"kiJ3wY9MEp"}],"key":"LYEB7piwQV"}],"identifier":"cell-015","html_id":"cell-015","key":"BknQHYD0hV"},
         모티프별 토큰 수: {motif_len}\")\n    print(f\"           가장 긴 토큰: {longest}\")\n\nfig, ax = plt.subplots(figsize=(4.5, 3))\nax.plot(list(sweep), [v[0] for v in sweep.values()], marker=\"o\")\nax.set_xscale(\"log\", base=2)\nax.set_xlabel(\"BPE vocab size\")\nax.set_ylabel(\"tokens / 1000 nt\")\nplt.tight_layout()\nplt.show()","key":"gMTXpFWJGL"},{"type":"outputs","id":"2kVu8zJiH3p-ApmB3PkbD","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"vocab=  128  tokens/1000nt=  322.3  compression=3.10x\n           모티프별 토큰 수: {'TATAAAAG': 3, 'GGGCGGGG': 1, 'CACGTGAC': 1, 'TTGACATG': 3}\n           가장 긴 토큰: ['GGGCGGGG', 'CACGTGAC', 'ACGTGAC', 'ATAAAA']\n"},"children":[],"key":"OOlsgoDz6D"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"vocab=  256  tokens/1000nt=  282.3  compression=3.54x\n           모티프별 토큰 수: {'TATAAAAG': 3, 'GGGCGGGG': 1, 'CACGTGAC': 1, 'TTGACATG': 3}\n           가장 긴 토큰: ['CGGGCGGGG', 'GGGGCGGGG', 'AGGGCGGGG', 'CACGTGACT']\n"},"children":[],"key":"dXPL0KZEmR"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"vocab=  512  tokens/1000nt=  251.8  compression=3.97x\n           모티프별 토큰 수: {'TATAAAAG': 3, 'GGGCGGGG': 1, 'CACGTGAC': 1, 'TTGACATG': 3}\n           가장 긴 토큰: ['GGGCGGGGTT', 'ATGGGCGGGG', 'AGGGCGGGGT', 'ATCACGTGAC']\n"},"children":[],"key":"YoDHDdRA7K"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"vocab= 1024  tokens/1000nt=  228.9  compression=4.37x\n           모티프별 토큰 수: {'TATAAAAG': 3, 'GGGCGGGG': 1, 'CACGTGAC': 1, 'TTGACATG': 3}\n           가장 긴 토큰: ['AGGGCGGGGTT', 'ATAGGGCGGGG', 'ATAAAAGATT', 'GGGGCGGGGT']\n"},"children":[],"key":"SZwqoBZoa8"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"vocab= 2048  tokens/1000nt=  210.8  compression=4.74x\n           모티프별 토큰 수: {'TATAAAAG': 3, 'GGGCGGGG': 1, 'CACGTGAC': 1, 'TTGACATG': 3}\n           가장 긴 토큰: ['GAGGGCGGGGT', 'ATACACGTGAC
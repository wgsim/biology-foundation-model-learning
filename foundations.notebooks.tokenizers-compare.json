:[{"type":"code","lang":"python","executable":true,"value":"AA = \"ACDEFGHIKLMNPQRSTVWY\"\nprot_rng = random.Random(1)\nprot_corpus = [\"\".join(prot_rng.choices(AA, k=300)) for _ in range(2000)]\n\n\ndef train_bpe_prot(texts, vocab_size):\n    tk = Tokenizer(models.BPE(unk_token=\"[UNK]\"))\n    trainer = trainers.BpeTrainer(\n        vocab_size=vocab_size, special_tokens=[\"[UNK]\", \"[PAD]\", \"[MASK]\"],\n        initial_alphabet=list(AA), show_progress=False)\n    tk.train_from_iterator(texts, trainer)\n    return tk\n\n\nfor vs in [64, 256, 1024]:\n    tk = train_bpe_prot(prot_corpus[:1500], vs)\n    n_tok = np.mean([len(tk.encode(s).tokens) for s in prot_corpus[1500:1600]])\n    print(f\"vocab={vs:5d}  tokens/300aa={n_tok:6.1f}  compression={300 / n_tok:4.2f}x\")","key":"fv5eFycGpp"},{"type":"outputs","id":"Srd-uPJdnNMnX3-p7vhpT","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"vocab=   64  tokens/300aa= 269.6  compression=1.11x\n"},"children":[],"key":"vfZbZULh5o"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"vocab=  256  tokens/300aa= 187.2  compression=1.60x\n"},"children":[],"key":"KspPrbNIrk"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"vocab= 1024  tokens/300aa= 160.9  compression=1.86x\n"},"children":[],"key":"td30ncQBYE"}],"key":"cMDpLAzZ9q"}],"identifier":"cell-019","html_id":"cell-019","key":"IPgkzac0Ok"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"관찰과 주의","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jLELYGIE7S"}],"key":"jLM3Ubf8KV"},{"type":"text","value":": 모티프가 전혀 없는 무작위 서열인데도 어휘를 키우면 압축률이 올라간다. 우연히 자주 등장하는 짧은 조각이 병합되기 때문이다.\n즉 ","position":{"start":{"line":1,"column":1
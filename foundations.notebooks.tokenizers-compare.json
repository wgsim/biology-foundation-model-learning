nlineCode","value":"GGGCGGGGGGCGGGG","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"xw2Rv1M74s"},{"type":"text","value":")이 생길 수 있다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"bDA8L0fQDJ"}],"key":"KMg8TCcpPt"}],"identifier":"cell-002","html_id":"cell-002","key":"fn6Rze5MMu"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:40:16.989262Z","iopub.status.busy":"2026-11-10T19:40:16.989088Z","iopub.status.idle":"2026-11-10T19:40:17.148032Z","shell.execute_reply":"2026-11-10T19:40:17.147297Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"BASES = \"ACGT\"\nBG_P = [0.3, 0.2, 0.2, 0.3]\nMOTIFS = [\"TATAAAAG\", \"GGGCGGGG\", \"CACGTGAC\", \"TTGACATG\"]  # 장난감 모티프 (실제 조절 모티프와 무관)\nSEQ_LEN = 1000\n\n\ndef make_seq(length=SEQ_LEN, n_motifs=12):\n    seq = rng.choices(BASES, weights=BG_P, k=length)\n    for _ in range(n_motifs):\n        m = rng.choice(MOTIFS)\n        pos = rng.randrange(0, length - len(m))\n        seq[pos:pos + len(m)] = list(m)\n    return \"\".join(seq)\n\n\ncorpus = [make_seq() for _ in range(2000)]\nprint(len(corpus), \"sequences x\", SEQ_LEN, \"nt\")\nprint(corpus[0][:80])","key":"u461578Fdf"},{"type":"outputs","id":"9QV017zd63WOU_NZB3lhz","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"2000 sequences x 1000 nt\nTTCAGCTCCGTGATGATTTTCTTGCACGTTCTATGATCTGACTACTAGATTCACGTAGTGTGTGGGGCGGGGGGCGGGGT\n"},"children":[],"key":"wi7VLrSedk"}],"key":"bh1VgPzifd"}],"identifier":"cell-003","html_id":"cell-003","key":"Ye9mAagavv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. 토크나이저 4종","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UBF6ZaOaVS"}],"identifier":"id-2-4","label":"2. 토크나이저 4종","html_id":"id-2-4","implicit":true,"key":"aKLEUv7aiA"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"단일 뉴클레오타이드: 문자 하나 = 토큰","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"dNPJLM3LEd"}],"key":"euXdTulYvL"}],"key":"apbVSvoYfO"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"겹침 k-mer: 1칸씩 이동하는 윈도 (DNABERT 방식)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qcpRN783vK"}],"key":"thfEhiTtyO"}],"key":"f0nYquSpnx"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"비겹침 k-mer: k칸씩 이동 (마지막의 남는 조각은 단순화를 위해 버림)","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"d9rWqPQW6g"}],"key":"sfvEO2XX6c"}],"key":"b8KTivFG4T"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BPE: Hugging Face ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"CX7uryLFVq"},{"type":"inlineCode","value":"tokenizers","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jbMOfLoVX7"},{"type":"text","value":" 라이브러리로 코퍼스에서 학습","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"X1wgazrddl"}],"key":"fQN0mxIjts"}],"key":"W9Wn8rF1cl"}],"key":"N0xle3yFdD"}],"identifier":"cell-004","html_id":"cell-004","key":"cyJLiNNsC8"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:40:17.149749Z","iopub.status.busy":"2026-11-10T19:40:17.149635Z","iopub.status.idle":"2026-11-10T19:40:17.858017Z","shell.execute_reply":"2026-11-10T19:40:17.857528Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"K = 6\n\n\ndef tok_single(seq):\n    return list(seq)\n\n\ndef tok_kmer_overlap(seq, k=K):\n    return [seq[i:i + k] for i in range(len(seq) - k + 1)]\n\n\ndef tok_kmer_nonoverlap(seq, k=K):\n    return [seq[i:i + k] for i in range(0, len(seq) - k + 1, k)]\n\n\ndef train_bpe(texts, vocab_size):\n    tk = Tokenizer(models.BPE(unk_token=\"[UNK]\"))\n    trainer = trainers.BpeTrainer(\n        vocab_size=vocab_size,\n        special_tokens=[\"[UNK]\", \"[PAD]\", \"[MASK]\"],\n        initial_alphabet=list(BASES),\n        show_progress=False,\n    )\n    tk.train_from_iterator(texts, trainer)\n    return tk\n\n\nbpe512 = train_bpe(corpus, 512)\n\n\ndef tok_bpe(seq, tk=bpe512):\n    return tk.encode(seq).tokens\n\n\nprint(tok_bpe(corpus[0])[:12])","key":"CwBtmVOWwI"},{"type":"outputs","id":"Xgi5RK6CRqQIV25xMxIAe","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"['TT', 'CAGCT', 'CCGT', 'GAT', 'GATTTT', 'CTT', 'GCAC', 'GTTCT', 'ATGAT', 'CT', 'GACT', 'ACT']\n"},"children":[],"key":"x2QINE6cRs"}],"key":"XJ4VRzsFDG"}],"identifier":"cell-005","html_id":"cell-005","key":"tot3cHXrnp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. 토큰 수 · 어휘 크기 · attention 비용","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Oj9cG3wKLL"}],"identifier":"id-3-attention","label":"3. 토큰 수 · 어휘 크기 · attention 비용","html_id":"id-3-attention","implicit":true,"key":"DEjPM6igLS"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"표준 attention 비용은 토큰 수의 제곱에 비례하므로, 단일 뉴클레오타이드(1000토큰)를 기준으로 상대 비용을 계산한다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ZBFi3iMVo5"}],"key":"rFcxORCjQM"}],"identifier":"cell-006","html_id":"cell-006","key":"RCXdM1CQ2X"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:40:17.859507Z","iopub.status.busy":"2026-11-10T19:40:17.859407Z","iopub.status.idle":"2026-11-10T19:40:18.143002Z","shell.execute_reply":"2026-11-10T19:40:18.142440Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def summarize(name, fn, vocab):\n    n_tok = float(np.mean([len(fn(s)) for s in corpus[:200]]))\n    return {\"name\": name, \"vocab\": vocab, \"tokens\": n_tok, \"rel_attn\": (n_tok / SEQ_LEN) ** 2}\n\n\nrows = [\n    summarize(\"single nt\", tok_single, 4),\n    summarize(f\"k-mer overlap (k={K})\", tok_kmer_overlap, 4 ** K),\n    summarize(f\"k-mer non-overlap (k={K})\", tok_kmer_nonoverlap, 4 ** K),\n    summarize(\"BPE (vocab=512)\", tok_bpe, bpe512.get_vocab_size()),\n]\nprint(f\"{'tokenizer':26s}{'vocab':>8s}{'tokens/1000nt':>16s}{'rel. attn cost':>16s}\")\nfor r in rows:\n    print(f\"{r['name']:26s}{r['vocab']:>8d}{r['tokens']:>16.1f}{r['rel_attn']:>16.3f}\")\n\nfig, ax = plt.subplots(1, 2, figsize=(9, 3))\nax[0].bar([r[\"name\"] for r in rows], [r[\"tokens\"] for r in rows])\nax[0].set_title(\"tokens per 1000 nt\")\nax[0].tick_params(axis=\"x\", rotation=30)\nax[1].bar([r[\"name\"] for r in rows], [r[\"rel_attn\"] for r in rows])\nax[1].set_yscale(\"log\")\nax[1].set_title(\"relative attention cost (log)\")\nax[1].tick_params(axis=\"x\", rotation=30)\nplt.tight_layout()\nplt.show()","key":"WQJjQxuBTl"},{"type":"outputs","id":"Q4hEw733il8auYpYS9Vgb","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"tokenizer                    vocab   tokens/1000nt  rel. attn cost\nsingle nt                        4          1000.0           1.000\nk-mer overlap (k=6)           4096           995.0           0.990\nk-mer non-overlap (k=6)       4096           166.0           0.028\nBPE (vocab=512)                512           251.7           0.063\n"},"children":[],"key":"ihjYy1M6Us"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"ecd7c71540d33865c0538556f0e7c353","path":"/biology-foundation-model-learning/_public/ecd7c71540d33865c0538556f0e7c353.png"},"text/plain":{"content":"<Figure size 900x300 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"MH5SzzlKG4"}],"key":"OPLTEYpQHl"}],"identifier":"cell-007","html_id":"cell-007","key":"wy7FCDbNDA"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"생각해 볼 점","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nHZ89P7nMa"}],"key":"khIiYs5XUl"}],"key":"i5A4HHA5V2"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"겹침 k-mer는 어휘는 크지만 토큰 수가 서열 길이와 거의 같다. 비용 측면의 이득이 있는가?","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Ys0Mjs6z9f"}],"key":"VFsVsHhJsi"}],"key":"R8awD6B9jz"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"비겹침 k-mer와 BPE는 비용이 줄어든다. 대신 무엇을 잃는가? (아래 4~5절)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kp1MVTBnrx"}],"key":"pt13A4EjGM"}],"key":"paOeRBO5sh"}],"key":"ye4UnSehco"}],"identifier":"cell-008","html_id":"cell-008","key":"wgOn70hVH3"},{"type":"block","kind":"notebook-content","childre
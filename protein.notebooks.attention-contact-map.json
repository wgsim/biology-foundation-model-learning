\"))    # 원하면 지워 기본 HF 캐시를 쓴다\nPDB_DIR = (ROOT / \".cache\" / \"pdb\") if ROOT else Path(\"pdb_files\")\nPDB_DIR.mkdir(parents=True, exist_ok=True)\n\nimport matplotlib.pyplot as plt\nimport torch\nfrom Bio.PDB import PDBParser\nfrom Bio.SeqUtils import seq1\nfrom transformers import AutoTokenizer, EsmForMaskedLM\nfrom transformers.utils import logging as hf_logging\n\nhf_logging.set_verbosity_error()\nhf_logging.disable_progress_bar()\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"mps\" if torch.backends.mps.is_available() else \"cpu\")\nprint(\"device:\", DEVICE, \"| pdb dir:\", PDB_DIR)","key":"JmdaY2iLLu"},{"type":"outputs","id":"E5yzrsglh00cWG0rCawuq","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"W1110 11:46:50.581000 23380 torch/distributed/elastic/multiprocessing/redirects.py:35] NOTE: Redirects are currently not supported in MacOs.\n"},"children":[],"key":"ytgVCmJYVu"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"device: mps | pdb dir: <repo>/.cache/pdb\n"},"children":[],"key":"BPoH9Mvtdp"}],"key":"nyvIKL1TlW"}],"identifier":"cell-001","html_id":"cell-001","key":"TmPOFCGFLR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. 구조 불러오기와 정답 접촉","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"y3k9YBp00y"}],"identifier":"id-1","label":"1. 구조 불러오기와 정답 접촉","html_id":"id-1","implicit":true,"key":"ldLhygZ0eY"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"RCSB PDB에서 3개를 받는다 (출처: ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Ej9covcCTx"},{"type":"link","url":"http://files.rcsb.org/download/","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"files​.rcsb​.org​/download/","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"O7tw4cuxRd"}],"urlSource":"http://files.rcsb.org/download/","key":"Kc8O3cY9sK"},{"type":"text","value":".pdb). 표준 잔기 중 Cα가 있는 것만 쓰고, 서열은 같은 잔기들로 만든다.\n잔기 번호에 **빈 구간(결측 잔기)**이 있으면 서열이 이어 붙여지므로 경고를 출력한다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"GH0SFqLH1t"}],"key":"yykBFe9rlv"}],"identifier":"cell-002","html_id":"cell-002","key":"C88PON1wMs"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:46:50.936993Z","iopub.status.busy":"2026-11-10T19:46:50.936824Z","iopub.status.idle":"2026-11-10T19:46:50.955690Z","shell.execute_reply":"2026-11-10T19:46:50.955321Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"PROTEINS = {\"1UBQ\": \"A\", \"1PGA\": \"A\", \"1AKI\": \"A\"}\nfor pid in PROTEINS:\n    path = PDB_DIR / f\"{pid}.pdb\"\n    if not path.exists():\n        print(\"downloading\", pid)\n        urllib.request.urlretrieve(f\"https://files.rcsb.org/download/{pid}.pdb\", path)\n\n\ndef load_structure(pid, chain_id):\n    s = PDBParser(QUIET=True).get_structure(pid, PDB_DIR / f\"{pid}.pdb\")\n    residues = [r for r in s[0][chain_id] if r.id[0] == \" \" and \"CA\" in r]\n    seq = \"\".join(seq1(r.get_resname()) for r in residues)\n    nums = [r.id[1] for r in residues]\n    if any(b - a != 1 for a, b in zip(nums, nums[1:])):\n        print(f\"[경고] {pid}: 잔기 번호에 빈 구간이 있음 — 서열이 이어 붙여짐\")\n    def cb_coord(r):\n        if r.get_resname() == \"GLY\":\n            return r[\"CA\"].coord                                    # 글리신만 Cα를 쓴다\n        if \"CB\" in r:\n            return r[\"CB\"].coord\n        print(f\"[경고] {pid} {r.get_resname()}{r.id[1]}: Cβ 원자가 없어 Cα로 대체 (접촉 정답이 달라질 수 있음)\")\n        return r[\"CA\"].coord\n\n    cb = np.array([cb_coord(r) for r in residues])\n    dist = np.linalg.norm(cb[:, None] - cb[None], axis=-1)\n    return seq, dist\n\n\nstructs = {pid: load_structure(pid, ch) for pid, ch in PROTEINS.items()}\nMIN_SEP = 12         # 서열 거리 ≥ 12인 쌍(중·장거리)만 평가. 작은 단백질이라 24 대신 12를 쓴다\nCUTOFF = 8.0\nfor pid, (seq, dist) in structs.items():\n    L = len(seq)\n    iu = np.triu_indices(L, k=MIN_SEP)\n    print(f\"{pid}: L={L}  접촉 쌍(<{CUTOFF:.0f}Å, 거리≥{MIN_SEP}): {(dist[iu] < CUTOFF).sum():4d} / {len(iu[0])}  → 밀도 {(dist[iu] < CUTOFF).mean():.3f}\")","key":"mL3qOTzCXr"},{"type":"outputs","id":"rD7F4UQAEwxnHVJDjqI-L","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"1UBQ: L=76  접촉 쌍(<8Å, 거리≥12):  111 / 2080  → 밀도 0.053\n1PGA: L=56  접촉 쌍(<8Å, 거리≥12):   84 / 990  → 밀도 0.085\n1AKI: L=129  접촉 쌍(<8Å, 거리≥12):  197 / 6903  → 밀도 0.029\n"},"children":[],"key":"xe01hJtpdz"}],"key":"c8NL4lSq7D"}],"identifier":"cell-003","html_id":"cell-003","key":"S9NQpyLoEU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. 평가 함수와 trivial baseline","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"G9y9oXomeA"}],"identifier":"id-2-trivial-baseline","label":"2. 평가 함수와 trivial baseline","html_id":"id-2-trivial-baseline","implicit":true,"key":"Cyx5RRQJ0f"}],"identifier":"cell-004","html_id":"cell-004","key":"Dx56Med17s"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:46:50.957066Z","iopub.status.busy":"2026-11-10T19:46:50.956981Z","iopub.status.idle":"2026-11-10T19:46:50.960561Z","shell.execute_reply":"2026-11-10T19:46:50.960118Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def precision_top(scores, dist, k=None, min_sep=MIN_SEP):\n    L = scores.shape[0]\n    k = k or max(1, L // 5)\n    iu = np.triu_indices(L, k=min_sep)\n    top = np.argsort(-scores[iu])[:k]\n    return float((dist[iu][top] < CUTOFF).mean())\n\n\ndef sep_prior(L):\n    i, j = np.indices((L, L))\n    return -np.abs(i - j).astype(float)                      # 서열상 가까운 쌍일수록 높은 점수\n\n\nfor pid, (seq, dist) in structs.items():\n    L = len(seq)\n    iu = np.triu_indices(L, k=MIN_SEP)\n    print(f\"{pid}: random 기대 {(dist[iu] < CUTOFF).mean():.2f} | 서열 거리 prior {precision_top(sep_prior(L), dist):.2f}\")","key":"aJ2ctxZlS7"},{"type":"outputs","id":"cDZxkgYV7bHvGTx5_nYzU","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"1UBQ: random 기대 0.05 | 서열 거리 prior 0.00\n1PGA: random 기대 0.08 | 서열 거리 prior 0.09\n1AKI: random 기대 0.03 | 서열 거리 prior 0.08\n"},"children":[],"key":"JaP6Vbht3m"}],"key":"uiGjG3bTRu"}],"identifier":"cell-005","html_id":"cell-005","key":"nrTz5bsfzu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. ESM-2의 attention과 contact head","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"t0bTXbmjQC"}],"identifier":"id-3-esm-2-attention-contact-head","label":"3. ESM-2의 attention과 contact head","html_id":"id-3-esm-2-attention-contact-head","implicit":true,"key":"ZPEgn7mOUT"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"attention 가중치를 얻으려면 ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"HLKg10PSwQ"},{"type":"inlineCode","value":"attn_implementation=\"eager\"","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NMvL9tMN6F"},{"type":"text","value":"로 로드해야 한다 (기본 SDPA 구현은 attention을 반환하지 않는다).\n","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"GuGXM4KiOk"},{"type":"inlineCode","value":"<cls>","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"YIldXs8vFc"},{"type":"text","value":"/","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AOovS1Wl51"},{"type":"inlineCode","value":"<eos>","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AWK9PxjzSS"},{"type":"text","value":"에 해당하는 행·열은 잘라 낸다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"jrOsyJ8QkU"}],"key":"kD6srU1e3q"}],"identifier":"cell-006","html_id":"cell-006","key":"CuXaWTVmtJ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:46:50.961806Z","iopub.status.busy":"2026-11-10T19:46:50.961723Z","iopub.status.idle":"2026-11-10T19:46:53.963272Z","shell.execute_reply":"2026-11-10T19:46:53.962652Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def apc(x):\n    \"\"\"Average Product Correction: 위치별 합이 큰 배경 편향을 제거.\"\"\"\n    a1, a2, a12 = x.sum(-1, keepdims=True), x.sum(-2, keepdims=True), x.sum((-1, -2), keepdims=True)\n    return x - a1 * a2 / a12\n\n\n@torch.no_grad()\ndef contact_scores(tok, model, seq):\n    enc = tok(seq, return_tensors=\"pt\").to(DEVICE)\n    out = model(**enc, output_attentions=True)\n    att = torch.stack(out.attentions)[:, 0, :, 1:-1, 1:-1].float()           # (layers, heads, L, L), cls/eos 제거\n    L = att.shape[-1]\n    att_sym = att + att.transpose(-1, -2)                                    # 대칭화\n    mean_sym = att_sym.mean((0, 1))\n    eye = torch.eye(L, dtype=torch.bool, device=mean_sym.device)\n    variants = {                                                             # 모든 층·head 평균에 보정을 단계적으로 적용 (비지도)\n        \"raw\": att.mean((0, 1)).cpu().numpy(),                               # 보정 없음 (비대칭: 윗삼각만 쓰이므로 한 방향 attention만 반영)\n        \"sym\": mean_sym.cpu().numpy(),                                       # 대칭화만\n        \"sym+APC\": apc(mean_sym).cpu().numpy(),                              # 대칭화 + APC\n        \"sym+diag0+APC\": apc(mean_sym.masked_fill(eye, 0)).cpu().numpy(),    # 자기 자신 attention(대각선)을 0으로 한 뒤 APC\n    }\n    per_head = apc(att_sym).cpu().numpy()                                    # (layers, heads, L, L)\n    head = model.predict_contacts(enc[\"input_ids\"], enc[\"attention_mask\"])[0].float().cpu().numpy()   # 지도 학습된 contact head\n    return variants, per_head, head\n\n\nMODELS = {\"8M\": \"facebook/esm2_t6_8M_UR50D\", \"35M\": \"facebook/esm2_t12_35M_UR50D\",\n          \"150M\": \"facebook/esm2_t30_150M_UR50D\", \"650M\": \"facebook/esm2_t33_650M_UR50D\"}\nstore, rows = {}, []\nfor mname, hf_id in MODELS.items():\n    tok = AutoTokenizer.from_pretrained(hf_id)\n    model = EsmForMaskedLM.from_pretrained(hf_id, attn_implementation=\"eager\").to(DEVICE).eval()\n    for pid, (seq, dist) in structs.items():\n        variants, per_head, head = contact_scores(tok, model, seq)\n        store[(mname, pid)] = (variants, per_head, head)\n        rows.append(dict(model=mname, protein=pid, L=len(seq),\n                         **{k: precision_top(v, dist) for k, v in variants.items()},\n                         **{\"contact head\": precision_top(head, dist), \"contact head (sep≥24)\": precision_top(head, dist, min_sep=24)}))\n    print(mname, \"done | layers x heads:\", per_head.shape[:2], \"| contact head 출력 shape:\", head.shape)\n    del model\n    if DEVICE.type == \"mps\":\n        torch.mps.empty_cache()\nres = pd.DataFrame(rows)","key":"NNjiA6c8uF"},{"type":"outputs","id":"GObg7Z0Az5WT5bDQ11JKL","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"8M done | layers x heads: (6, 20) | contact head 출력 shape: (129, 129)\n"},"children":[],"key":"d3m72p3QiM"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"35M done | layers x heads: (12, 20) | contact head 출력 shape: (129, 129)\n"},"children":[],"key":"Pa5VmHLvqo"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"150M done | layers x heads: (30, 20) | contact head 출력 shape: (129, 129)\n"},"children":[],"key":"NlqJ251Vn4"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"650M done | layers x heads: (33, 20) | contact head 출력 shape: (129, 129)\n"},"children":[],"key":"N1Kdrsouf5"}],"key":"G8rWTL0f0Y"}],"identifier":"cell-007","html_id":"cell-007","key":"jl8LzyI8CQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. 결과 — precision@L/5 (서열 거리 ≥ 12)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xCQ6BdKjL1"}],"identifier":"id-4-precision-l-5-12","label":"4. 결과 — precision@L/5 (서열 거리 ≥ 12)","html_id":"id-4-precision-l-5-12","implicit":true,"key":"cAAAwOi39j"}],"identifier":"cell-008","html_id":"cell-008","key":"Kmz9jORYjD"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:46:53.965304Z","iopub.status.busy":"2026-11-10T19:46:53.965191Z","iopub.status.idle":"2026-11-10T19:46:53.973508Z","shell.execute_reply":"2026-11-10T19:46:53.973024Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"for col in [\"sym+APC\", \"contact head\"]:\n    print(f\"\\n=== {col} ===\")\n    print(res.pivot(index=\"model\", columns=\"protein\", values=col).reindex(MODELS).round(2).assign(평균=lambda d: d.mean(1).round(2)).to_string())","key":"yist1i9k5q"},{"type":"outputs","id":"u6yfHgdSGuZXE_1GxYRWU","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\n=== sym+APC ===\nprotein  1AKI  1PGA  1UBQ    평균\nmodel                          \n8M       0.04  0.45  0.07  0.19\n35M      0.04  0.55  0.33  0.31\n150M     0.04  0.64  0.40  0.36\n650M     0.12  0.55  0.67  0.45\n\n=== contact head ===\nprotein  1AKI  1PGA  1UBQ    평균\nmodel                          \n8M       0.04  0.45  0.40  0.30\n35M      0.36  0.55  0.73  0.55\n150M     0.72  0.91  0.87  0.83\n650M     0.84  0.91  0.93  0.89\n"},"children":[],"key":"wL8PUgP1gq"}],"key":"zJT86hDXkH"}],"identifier":"cell-009","htm
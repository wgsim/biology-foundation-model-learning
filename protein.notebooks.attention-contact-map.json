           0.31          0.55\n150M   0.03  0.23     0.36           0.37          0.83\n650M   0.27  0.30     0.44           0.41          0.89\n"},"children":[],"key":"qQmZSwRfmz"}],"key":"MgJCjVXBMa"}],"identifier":"cell-011","html_id":"cell-011","key":"YccDYj1jBy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"장거리 기준 (서열 거리 ≥ 24)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Tw7eHqLmAa"}],"identifier":"id-24","label":"장거리 기준 (서열 거리 ≥ 24)","html_id":"id-24","implicit":true,"key":"L5QZAlkKDb"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"표준 접촉 벤치마크는 서열 거리에 따라 단거리(≥6)·중거리(≥12)·장거리(≥24)를 구분한다. 작은 단백질은 장거리 쌍이 적어 통계가 불안정하므로 쌍의 수를 함께 본다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"UU1M4qsZJO"}],"key":"zmBkTGyOpJ"}],"identifier":"cell-012","html_id":"cell-012","key":"KUvk7s3c5f"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:46:53.980026Z","iopub.status.busy":"2026-11-10T19:46:53.979940Z","iopub.status.idle":"2026-11-10T19:46:53.984577Z","shell.execute_reply":"2026-11-10T19:46:53.984104Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"for pid, (seq, dist) in structs.items():\n    iu = np.triu_indices(len(seq), k=24)\n    print(f\"{pid}: 서열 거리 ≥ 24 쌍 {len(iu[0])}개 중 접촉 {(dist[iu] < CUTOFF).sum()}개, k = L//5 = {len(seq) // 5}\")\nprint(res.pivot(index=\"model\", columns=\"protein\", values=\"contact head (sep≥24)\").reindex(MODELS).round(2).assign(평균=lambda d: d.mean(1).round(2)).to_string())","key":"dASSLyK7WY"},{"type":"outputs","id":"qP9YkaJiOMGL3MMPRqIvU","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"1UBQ: 서열 거리 ≥ 24 쌍 1378개 중 접촉 81개, k = L//5 = 15\n1PGA: 서열 거리 ≥ 24 쌍 528개 중 접촉 47개, k = L//5 = 11\n1AKI: 서열 거리 ≥ 24 쌍 5565개 중 접촉 128개, k = L//5 = 25\nprotein  1AKI  1PGA  1UBQ    평균\nmodel                          \n8M       0.00  0.36  0.40  0.25\n35M      0.20  0.73  0.73  0.55\n150M     0.48  0.64  0.87  0.66\n650M     0.64  0.82  1.00  0.82\n"},"children":[],"key":"njUpnt1fWd"}],"key":"Rqj1587KWf"}],"identifier":"cell-013","html_id":"cell-013","key":"KNjL3wT1uj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. head 하나를 고르면 좋아질까? — 누출 없는 선택","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uaGvTNx7fM"}],"identifier":"id-5-head","label":"5. head 하나를 고르면 좋아질까? — 누출 없는 선택","html_id":"id-5-head","implicit":true,"key":"Ycq1SEZqfQ"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"층·head마다 점수를 매겨 보면 일부 head가 접촉에 특화돼 있다. 그러나 ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"uTyPRsjqiZ"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"평가 단백질에서 가장 좋은 head를 고르면 낙관적","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"y8ERHuD3pu"}],"key":"q2mVNjCvUs"},{"type":"text","value":"이다 (모듈 01).\n여기서는 ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"A2PFUf1m4O"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"leave-one-protein-out","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ntTUcWRlzA"}],"key":"XPNBeaGkSr"},{"type":"text","value":": 평가 단백질을 뺀 나머지 단백질에서 평균이 가장 높은 head를 골라 평가 단백질에 적용한다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NxkeA1GTxf"}],"key":"W8bI26Q5uo"}],"identifier":"cell-014","html_id":"cell-014","key":"SzYISvCETg"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:46:53.985701Z","iopub.status.busy":"2026-11-10T19:46:53.985620Z","iopub.status.idle":"2026-11-10T19:46:54.537318Z","shell.execute_reply":"2026-11-10T19:46:54.536852Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def head_precisions(per_head, dist):\n    nl, nh = per_head.shape[:2]\n    return np.array([[precision_top(per_head[l, h], dist) for h in range(nh)] for l in range(nl)])\n\n\nout = []\nfor mname in [\"35M\", \"150M\"]:\n    P = {pid: head_precisions(store[(mname, pid)][1], structs[pid][1]) for pid in structs}\n    for pid in structs:\n        others = np.mean([P[q] for q in structs if q != pid], axis=0)\n        l, h = np.unravel_index(others.argmax(), others.shape)\n        out.append(dict(model=mname, protein=pid, **{\"선택 head (층,head)\": f\"({l},{h})\", \"선택 head 정밀도\": P[pid][l, h],\n                                                  \"평가 단백질 내 최고 head(낙관적)\": P[pid].max(), \"낙관성 격차(최고−선택)\": P[pid].max() - P[pid][l, h],\n                                                  \"평균 head\": P[pid].mean()}))\ngap = pd.DataFrame(out)\nprint(gap.round(2).to_string(index=False))\nprint(\"\\n모델별 평균 낙관성 격차:\", gap.groupby(\"model\")[\"낙관성 격차(최고−선택)\"].mean().round(2).to_dict(), \"| 단백질 3개뿐이므로 leave-one-out 자체도 불확실하다\")","key":"sGBV386QHi"},{"type":"outputs","id":"FpU536fjDqjlfmKspXpcJ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"model protein 선택 head (층,head)  선택 head 정밀도  평가 단백질 내 최고 head(낙관적)  낙관성 격차(최고−선택)  평균 head\n  35M    1UBQ           (10,2)         0.33                   0.87           0.53     0.11\n  35M    1PGA          (11,13)         0.45                   0.64           0.18     0.18\n  35M    1AKI          (11,13)         0.36                   0.44           0.08     0.05\n 150M    1UBQ          (27,16)         0.87                   0.87           0.00     0.10\n 150M    1PGA          (27,16)         0.91                   0.91           0.00     0.20\n 150M    1AKI          (27,16)         0.64                   0.64           0.00     0.07\n\n모델별 평균 낙관성 격차: {'150M': 0.0, '35M': 0.27} | 단백질 3개뿐이므로 leave-one-out 자체도 불확실하다\n"},"children":[],"key":"JjodsMhZEW"}],"key":"Esr2MGOoNI"}],"identifier":"cell-015","html_id":"cell-015","key":"iXW94wpXPN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. 시각화 — 1UBQ (650M)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jmvHJ36mKO"}],"identifier":"id-6-1ubq-650m","label":"6. 시각화 — 1UBQ (650M)","html_id":"id-6-1ubq-650m","implicit":true,"key":"AoZiaf81MS"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"윗삼각은 실제 접촉(<8 Å), 아랫삼각은 contact head의 예측 확률이다. 대각선에서 먼 쌍이 얼마나 맞는지 본다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"LwNSRYdDg3"}],"key":"oa62cFuH7k"}],"identifier":"cell-016","html_id":"cell-016","key":"jAvhkp17M3"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T19:46:54.538798Z","iopub.status.busy":"2026-11-10T19:46:54.538702Z","iopub.status.idle":"2026-11-10T19:46:54.651325Z","shell.execute_reply":"2026-11-10T19:46:54.650697Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"seq, dist = structs[\"1UBQ\"]\nhead = store[(\"650M\", \"1UBQ\")][2]\nL = len(seq)\ncanvas = np.full((L, L), np.nan)\niu, il = np.triu_indices(L, k=1), np.tril_indices(L, k=-1)\ncanvas[iu] = (dist[iu] < CUTOFF).astype(float)\ncanvas[il] = head[il]\nfig, ax = plt.subplots(figsize=(4.5, 4.2))\nim = ax.imshow(canvas, cmap=\"Blues\", vmin=0, vmax=1)\nax.set_title(\"1UBQ: true contacts (upper) / ESM-2 650M contact head (lower)\", fontsize=8)\nplt.colorbar(im, fraction=0.046)\nplt.tight_layout()\nplt.show()","key":"VnVJYdKdAn"},{"type":"outputs","id":"dQYsXjZbijLOFwE6oj0SE","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"25664175f82cae57fec5d90e843d63ef","path":"/biology-foundation-model-learning/_public/25664175f82cae57fec5d90e843d63ef.png"},"text/plain":{"content":"<Figure size 450x420 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"qWzd41Tfp7"}],"key":"npHiSMDvF4"}],"identifier":"cell-017","html_id":"cell-017","key":"AjvaGVoDgx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"7. 해석 가이드와 한계","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pKbLczuXBr"}],"identifier":"id-7","label":"7. 해석 가이드와 한계","html_id":"id-7","implicit":true,"key":"VP6UWN9hkP"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"아래는 이 실행(MPS, 결정적 계산)에서 읽은 내용이다. ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"CCGwZmiLod"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"표를 직접 확인한다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SssHNUYCLY"}],"key":"UcKKsVGpCn"}],"key":"THnmISoZTP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"baseline과의 비교","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"letcIllvmH"}],"key":"S1hXTNwBsO"},{"type":"text","value":": 무작위 기대 정밀도는 0.03~0.08, 서열 거리 prior는 0.00~0.09다. attention 기반 점수가 ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AUlIIKE09e"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"항상","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"n0C3WeNvDV"}],"key":"Q8Ae15WLrF"},{"type":"text","value":" 이를 넘는 것은 아니다.\n1AKI(129 aa)의 비지도 점수(sym+APC)는 8M~150M에서 0.04로 서열 거리 prior(0.08)보다 낮고 650M에서야 0.12가 된다. 1UBQ·1PGA에서는 대부분 크게 넘는다.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wgOwiHJYMj"}],"key":"fLZdliYnhh"}],"key":"CcBPBj6060"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"모델이 커질수록 오른다 (3개 평균 precision@L/5)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"lsWbsk6HM0"}],"key":"hBH0AC4Ac3"},{"type":"text","value":": 지도 학습된 contact head는 0.30(8M), 0.55(35M), 0.83(150M), 0.89(650M)이고, 비지도 sym+APC는 0.19, 0.31, 0.36, 0.44다.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"iKmha15BMG"}],"key":"IDXvEK6Qee"}],"key":"Y2eFhQlLx7"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"보정의 효과 (비지도, 3개 평균)","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"UOY3p1LLoE"}],"key":"KDwEg8ustl"},{"type":"text","value":": raw, 대칭화, +APC 순으로 오른다. 8M은 0.07, 0.12, 0.19, 35M은 0.15, 0.16, 0.31, 150M은 0.03, 0.23, 0.36, 650M은 0.27, 0.30, 0.44다.\n대각선(자기 attention)을 0으로 만든 뒤 APC를 적용한 변형은 일관된 차이가 없었다(−0.03~+0.01). 다만 raw는 비대칭 행렬의 윗삼각만 써서 한 방향 정보만 반영한다.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"OCrYlUZvh1"}],"key":"JsWp0sZMPg"}],"key":"kojEWG2aW7"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"비지도와 지도의 차이","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"yIk3LpjjkW"}],"key":"k0NDA2r77A"},{"type":"text","value":": 비지도 점수는 지도 학습된 contact head보다 모든 크기에서 낮다. contact head는 접촉 라벨로 학습된 선형 층이 포함되어 있어 순수 비지도 결과가 아니다†.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"wbiDG0th6f"}],"key":"ANlVTT1zpE"}],"key":"yYT54qSyYD"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"장거리 기준(서열 거리 ≥ 24)","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"RbQslu3a3A"}],"key":"LjzHzkoMlG"},{"type":"text","value":": contact head 평균은 0.25(8M), 0.55, 0.66, 0.82(650M)다. 작은 단백질은 장거리 쌍이 적고 k = L//5가 11~25개뿐이라 통계가 불안정하다.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"OsIa5IWA4A"}],"key":"f4qR5Qy2wT"}],"key":"tZunwpo6sx"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"head 선택의 낙관성 (5절)","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"UYjCjJfVIA"}],"key":"vqR1fPEujC"},{"type":"text","value":": 35M에서는 leave-on
:1},"end":{"line":7,"column":1}},"key":"plwq0x9x09"},{"type":"inlineCode","value":"device_map={\"\": 0}","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"iw9g1jtNaU"},{"type":"text","value":"으로 GPU에 바로 올린다. GPU 메모리가 더 작은 장치(예: 8 GB)에서는 이 노트북이 그대로 돌지 않는다.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"mPJnOh5njf"}],"key":"SVYu05PuZh"}],"key":"uAhOmJbHlx"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"strong","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"목표","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"giPAdqhLYl"}],"key":"BFMCrw1OF6"},{"type":"text","value":": (1) 서열에서 구조를 예측하고 (2) 잔기별 ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"uVzLOgwyjj"},{"type":"strong","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"pLDDT","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"bjTt3k6ZBY"}],"key":"ZU8xBM9Z3y"},{"type":"text","value":"를 읽고 (3) 실험 구조와 비교(RMSD)하고 (4) 대조 서열(섞은 서열, 저복잡도 서열)에서 신뢰도가 어떻게 달라지는지 본다.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"cdZLsiOEnk"}],"key":"M1umvytgpf"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"참고: 2026년에 ESM 팀(Biohub)이 ESMFold2를 공개했다 (모델 카드·프리프린트는 모듈 README 참고). 가중치가 훨씬 커서 이 노트북은 ESMFold v1을 쓴다.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"q0vYhB3g3c"}],"key":"Q3CHLHf0dV"}],"identifier":"cell-000","html_id":"cell-000","key":"zjMdBSFp0f"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Colab에서만 필요 (로컬에서는 SETUP.md의 환경을 사용):\n# !pip -q install transformers accelerate biopython\n\nimport io\nimport time\nimport urllib.request\nimport warnings\n\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport torch\nfrom Bio.PDB import PDBParser, Superimposer\nfrom transformers import EsmForProteinFolding\n\nwarnings.filterwarnings(\"ignore\")\nassert torch.cuda.is_available(), \"GPU 런타임이 필요합니다 (Colab: 런타임 > 런타임 유형 변경 > T4 GPU)\"\nDEVICE = torch.device(\"cuda\")\ntorch.backends.cuda.matmul.allow_tf32 = True","key":"tJ9a1WYnoJ"},{"type":"outputs","id":"lDyArfH60z_AJhL5j-WSo","children":[],"key":"e32lKzyjwH"}],"identifier":"cell-001","html_id":"cell-001","key":"lw4A8cBUbN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. 모델 로드","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"H3MEKCHFSF"}],"identifier":"id-1","label":"1. 모델 로드","html_id":"id-1","implicit":true,"key":"e8jgW8fuU0"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"device_map={\"\": 0}","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Z2sq6vNtze"},{"type":"text","value":"로 가중치를 GPU에 바로 올린다. CPU로 먼저 불러오면 fp32 전체(약 14 GB)가 Colab 무료 런타임의 RAM(약 12 GB)을 넘겨 커널이 죽을 수 있다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AVcTthQ1pf"}],"key":"IGDOEsXszh"}],"key":"jeI94DRcy8"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"ESM-2 backbone을 fp16으로 두어 메모리를 줄인다 (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SuDucwfCNL"},{"type":"inlineCode","value":"model.esm = model.esm.half()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aqwYWmLld3"},{"type":"text","value":"). 로드 직후에는 fp32 전체가 GPU에 있어 순간 최대 약 14 GB를 쓴다 (T4 15 GB에서 한계에 가깝다).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZdCbT7i7LE"}],"key":"AD09hLx57K"}],"key":"ycYaDRz1YP"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"긴 서열의 메모리를 줄이도록 chunk 크기를 ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"yakcAjIua6"},{"type":"inlineCode","value":"model.trunk.set_chunk_size(64)","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"klzc5A0DAx"},{"type":"text","value":"로 설정한다.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"yJcRoBuE0S"}],"key":"FaBTFkXXc4"}],"key":"sACKpJol2z"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"로드 보고서에 ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"YbZEe2KU3A"},{"type":"inlineCode","value":"esm.contact_head.regression.*","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"McCPdHNls3"},{"type":"text","value":"가 ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"vsHFp7F6oz"},{"type":"inlineCode","value":"MISSING","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"UuSzGVzm7V"},{"type":"text","value":"으로 나오지만 무시해도 된다. ESMFold의 접기 경로(","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"uyUyBb6zoF"},{"type":"inlineCode","value":"modeling_esmfold.py","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"kSTg97s4ud"},{"type":"text","value":")는 접촉 예측 헤드를 호출하지 않는다(transformers 5.22.1 소스에서 확인).","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"sfpZEOxOV7"}],"key":"TVzwJcX8jM"}],"key":"OJNkSWfRae"}],"key":"BCHSHoGIXE"}],"identifier":"cell-002","html_id":"cell-002","key":"ZnQGdFRP6s"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from huggingface_hub import snapshot_download\n\n# 리비전을 고정하고 로컬 경로에서 불러온다 (저장소 ID로 열면 .bin 전용 저장소에서 자동 변환 PR 파일이 섞인 적이 있다: 모듈 05).\n# pytorch_model.bin은 pickle이다. 공식 facebook 저장소(MIT)의 고정 리비전만 쓰고, 로딩은 transformers의 weights_only 경로에 맡긴다.\nESMFOLD_REV = \"75a3841ee059df2bf4d56688166c8fb459ddd97a\"\nESMFOLD_DIR = snapshot_download(\"facebook/esmfold_v1\", revision=ESMFOLD_REV)          # 약 8.4 GB\n# 가중치를 CPU를 거치지 않고 GPU로 바로 올린다. CPU로 먼저 불러오면 fp32 전체(약 14 GB)가 RAM 12 GB를 넘겨 커널이 OOM으로 죽을 수 있다(T4 런타임에서 실제로 겪었다).\nmodel = EsmForProteinFolding.from_pretrained(ESMFOLD_DIR, device_map={\"\": 0}).eval()\nmodel.esm = model.esm.half()                                                          # 이후 ESM-2 backbone만 fp16으로 (GPU 위에서 매개변수별로 변환)\nmodel.trunk.set_chunk_size(64)\nprint(\"params (M):\", round(sum(p.numel() for p in model.parameters()) / 1e6))","key":"TRFYLpoeNN"},{"type":"outputs","id":"3N2gPw-rhBGnN_SORYAdc","children":[],"key":"kt9iwdFrBm"}],"identifier":"cell-003","html_id":"cell-003","key":"rJUmp3u6HO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. 접기 함수와 pLDDT 추출","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"p2EHk5FXLF"}],"identifier":"id-2-plddt","label":"2. 접기 함수와 pLDDT 추출","html_id":"id-2-plddt","implicit":true,"key":"nRMrVJthK7"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"inlineCode","value":"model.infer(seq)","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NilWpoPafo"},{"type":"text","value":"가 원시 출력 dict를 반환한다. ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"O4EmoxQ2eR"},{"type":"inlineCode","value":"plddt","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"pmK0WjneTn"},{"type":"text","value":"의 shape은 ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"yKa9XBOy7I"},{"type":"inlineCode","value":"(1, L, 37)","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"n8IYyhVuBc"},{"type":"text","value":"(atom37별)이고, 잔기 값은 **CA 원자(인덱스 1)**를 쓴다.\nHF 구현의 pLDDT는 ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"EFt1EMFaB3"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"0~1 범위","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"r4c5b9HDja"}],"key":"ax0HQUdXlj"},{"type":"text","value":"일 수 있으므로(범주형 혼합의 평균) 0~100 척도로 맞춰 표시한다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"FqUjVk02UR"}],"key":"pD2gtvsST9"}],"identifier":"cell-004","html_id":"cell-004","key":"fq6bu2RSui"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"@torch.no_grad()\ndef fold(seq):\n    out = model.infer(seq)\n    plddt = out[\"plddt\"][0, :, 1].float().cpu().numpy()          # CA 원자의 pLDDT\n    assert plddt.max() <= 1.0 + 1e-3, \"pLDDT 척도가 0~1이 아닙니다 — 라이브러리 버전이 바뀌었는지 확인하세요\"\n    plddt = plddt * 100                                           # 0~100 척도로 (HF 구현은 0~1을 반환한다: 소스 확인)\n    pae = out[\"predicted_aligned_error\"][0].float().cpu().numpy() # (L, L) 잔기쌍 정렬 오차 예측 (단위·척도는 모델 문서 확인†)\n    pdb = model.output_to_pdb(out)[0]\n    ptm = float(out[\"ptm\"])\n    torch.cuda.empty_cache()\n    return pdb, plddt, ptm, pae\n\n\nUBQ = \"MQIFVKTLTGKTITLEVEPSDTIENVKAKIQDKEGIPPDQQRLIFAGKQLEDGRTLSDYNIQKESTLHLVLRLRGG\"      # PDB 1UBQ, 76 aa\nGB1 = \"MTYKLILNGKTLKGETTTEAVDAATAEKVFKQYANDNGVDGEWTYDDATKTFTVTE\"                            # PDB 1PGA, 56 aa\nrng = np.random.RandomState(0)\nSEQS = {\n    \"ubiquitin (1UBQ)\": UBQ,\n    \"protein G B1 (1PGA)\": GB1,\n    \"ubiquitin shuffled\": \"\".join(rng.permutation(list(UBQ))),                               # 조성은 같고 순서만 섞음\n    \"low complexity (GS)n\": \"GS\" * 38,\n}\nfolded = {}\nfor name, s in SEQS.items():\n    folded[name] = fold(s)\n    pdb, pl, ptm, pae = folded[name]\n    print(f\"{name:24s} L={len(s):3d}  mean pLDDT={pl.mean():5.1f}  min={pl.min():5.1f}  pTM={ptm:.2f}  mean PAE={pae.mean():.2f}\")","key":"Fic0k5wPRn"},{"type":"outputs","id":"nrlLdBo5TP7-23rkzG1VP","children":[],"key":"UVHvK7TS6x"}],"identifier":"cell-005","html_id":"cell-005","key":"Sqv8Uj4F3B"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. 잔기별 pLDDT","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NzxjMJHkS9"}],"identifier":"id-3-plddt","label":"3. 잔기별 pLDDT","html_id":"id-3-plddt","implicit":true,"key":"GlFAONW7MC"}],"identifier":"cell-006","html_id":"cell-006","key":"txUIG7Pzjw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(8, 3))\nfor name, (pdb, pl, ptm, pae) in folded.items():\n    ax.plot(pl, label=name, lw=1.5)\nax.axhline(70, color=\"gray\", ls=\"--\", lw=0.8)\nax.axhline(50, color=\"gray\", ls=\":\", lw=0.8)\nax.set_xlabel(\"residue\")\nax.set_ylabel(\"pLDDT (CA)\")\nax.legend(fontsize=7)\nplt.tight_layout()\nplt.show()","key":"q6Jc8R6mmi"},{"type":"outputs","id":"7tg2rFIuQVzfJ8lOD-OcS","children":[],"key":"auPV0wFI34"}],"identifier":"cell-007","html_id":"cell-007","key":"bMsill3EwN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"PAE (잔기쌍 정렬 오차 예측)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YW6V4ASBn1"}],"identifier":"pae","label":"PAE (잔기쌍 정렬 오차 예측)","html_id":"pae","implicit":true,"key":"TNClhrTG6D"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"pLDDT는 잔기별 국소 신뢰도이고, PAE는 ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"aaPX9yy5MF"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"두 잔기의 상대 배치","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"pPlTNTkelU"}],"key":"elDcgTBCTC"},{"type":"text","value":"에 대한 신뢰도다. 도메인 사이 배치는 pLDDT만으로 알 수 없고 PAE로 본다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Gesfi30zwI"}],"key":"oYU7lmO13O"}],"identifier":"cell-008","html_id":"cell-008","key":"g33r52YWHI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(1, 3, figsize=(10, 3))\nfor ax, name in zip(axes, [\"ubiquitin (1UBQ)\", \"protein G B1 (1PGA)\", \"ubiquitin shuffled\"]):\n    im = ax.imshow(folded[name][3], cmap=\"viridis_r\")\n    ax.set_title(name, fontsize=8)\n    plt.colorbar(im, ax=ax, fraction=0.046)\nplt.tight_layout()\nplt.show()","key":"cvgllAcnQe"},{"type":"outputs","id":"Er-aAR3l-4ywexAkFE4pz","children":[],"key":"TuDknhptSa"}],"identifier":"cell-009","html_id":"cell-009","key":"OF0mgiSrPv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. 실험 구조와 비교 (CA RMSD)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lkJzR1HSoN"}],"identifier":"id-4-ca-rmsd","label":"4. 실험 구조와 비교 (CA RMSD)","html_id":"id-4-ca-rmsd","implicit":true,"key":"Dlif6dXvsV"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"RCSB에서 1UBQ, 1PGA 구조를 내려받아 예측 구조와 CA 원자로 겹쳐 RMSD를 잰다. 서열 길이가 같고 잔기 순서가 같다는 가정(두 구조 모두 해당)이다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Me5OmEN03z"}],"key":"w4KyCEPBWa"}],"identifier":"cell-010","html_id":"cell-010","key":"TOOy7OHxpi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def ca_atoms(structure):\n    return [r[\"CA\"] for r in structure[0][\"A\"] if r.id[0] == \" \" and \"CA\" in r]\n\n\ndef rmsd_to_experiment(pid, pred_pdb):\n    path = f\"{pid}.pdb\"\n    for attempt in range(3):                                      # RCSB 연결이 일시적으로 끊길 수 있다 (Colab 실행에서 한 번 겪었다)\n        try:\n            urllib.request.urlretrieve(f\"https://files.rcsb.org/download/{pid}.pdb\", path)\n            break\n        except OSError:\n            if attempt == 2:\n                raise\n            time.sleep(3)\n    exp = PDBParser(QUIET=True).get_structure(\"exp\", path)\n    pred = PDBParser(QUIET=True).get_structure(\"pred\", io.StringIO(pred_pdb))\n    pred_ca = [r[\"CA\"] for r in pred[0].get_residues() if \"CA\" in r]\n    exp_ca = ca_atoms(exp)\n    assert len(exp_ca) == len(pred_ca), (len(exp_ca), len(pred_ca))\n    sup = Superimposer()\n    sup.set_atoms(exp_ca, pred_ca)\n    return sup.rms\n\n\nfor name, pid in [(\"ubiquitin (1UBQ)\", \"1UBQ\"), (\"protein G B1 (1PGA)\", \"1PGA\")]:\n    print(f\"{name:22s} CA RMSD vs experiment: {rmsd_to_experiment(pid, folded[name][0]):.2f} Å\")","key":"N2qxckC3Qd"},{"type":"outputs","id":"HEbKoFu5fEOWgUBgPOQEV","children":[],"key":"rywKtiB66k"}],"identifier":"cell-011","html_id":"cell-011","key":"WDlhcaWsS9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. 점 돌연변이의 영향 — 한 서열의 변이 몇 개","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KR2uDdrv2o"}],"identifier":"id-5","label":"5. 점 돌연변이의 영향 — 한 서열의 변이 몇 개","html_id":"id-5","implicit":true,"key":"SEGDoJNkdz"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"유비퀴틴의 무작위 점돌연변이 8개를 접고 평균 pLDDT 변화를 본다.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"mMwA5F1UxP"}],"key":"laQddnY04I"}],"identifier":"cell-012","html_id":"cell-012","key":"NMqkGNtqaM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"AA = \"ACDEFGHIKLMNPQRSTVWY\"\nwt_pl = folded[\"ubiquitin (1UBQ)\"][1]\nW = 5                                                                 # 변이 위치 ±5 잔기 창\nrows = []\nfor _ in range(8):\n    i = int(rng.randint(len(UBQ)))\n    new = rng.choice([a for a in AA if a != UBQ[i]])\n    mut = UBQ[:i] + new + UBQ[i + 1:]\n    _, pl, _, _ = fold(mut)\n    lo, hi = max(0, i - W), min(len(UBQ), i + W + 1)\n    rows.append((f\"{UBQ[i]}{i + 1}{new}\", pl.mean() - wt_pl.mean(), pl[lo:hi].mean() - wt_pl[lo:hi].mean()))\nfor m, d_all, d_loc in rows:\n    print(f\"{m:6s} Δ 평균 pLDDT(전체) = {d_all:+.2f} | Δ 평균 pLDDT(변이 ±{W}) = {d_loc:+.2f}\")","key":"bnDG2WTw5C"},{"type":"outputs","id":"GFL8dsakAFo3J9QbQ-kem","children":[],"key":"ezTFxdjL1F"}],"identifier":"cell-013","html_id":"cell-013","key":"E3jFS07p3M"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. 해석 가이드","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GTClnPa4MO"}],"identifier":"id-6","label":"6. 해석 가이드","html_id":"id-6","implicit":true,"key":"c1Y7YRhcYR"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"관찰한 결과","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"DaXQmdZDWD"}],"key":"lXtb9m06Fz"},{"type":"text","value":" (Colab T4, 단일 서열·단일 모델 가중치, 같은 코드 재실행에서 동일):","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"pFFbXmO8NF"}],"key":"FKVK3q4vVe"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"자연 단백질: 유비퀴틴 평균 pLDDT 90.5, GB1 89.0이고 실험 구조와의 CA RMSD는 0.84 Å, 0.42 Å였다. 두 단백질 모두 사전학습 데이터에 들어 있을 가능성이 있어(평가–사전학습 겹침, 모듈 01)† 이 수치만으로 처음 보는 단백질에서도 잘 맞는다고 말할 수 없다.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ER86B8XeN0"}],"key":"ImEAIVTSOH"}],"key":"ZNOg9iPiBv"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"대조군: 섞은 서열은 평균 pLDDT 42.8(pTM 0.18, 평균 PAE 19.7), ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"MAAeJ5gOIW"},{"type":"inlineCode","value":"(GS)n","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"yKAONfjiFP"},{"type":"text","value":" 저복잡도 서열은 27.3(pTM 0.09, 평균 PAE 19.9)이었다. 자연 단백질의 pTM은 0.83·0.76, 평균 PAE는 3.0·2.8였다. 다만 ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"SbwpVpyb03"},{"type":"strong","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"낮은 pLDDT = 무질서의 증명이 아니라 모델이 확신하지 못한다는 뜻","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"hlIR3eshKJ"}],"key":"J1H6MZykcB"},{"type":"text","value":"이다.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"DIKWzE3Pts"}],"key":"oHJSu42saP"}],"key":"xbaTKy73di"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"점돌연변이 8개: 전체 평균 pLDDT 변화는 −0.95~+0.29, 변이 ±5 창은 −1.98~+0.41로 대부분 ±1 안쪽이었다. L69T는 창 변화(−1.98)가 전체 변화(−0.94)의 두 배라 국소 효과가 전체 평균에 희석됨을 보여 준다. 표본이 8개뿐이고 pLDDT 변화는 변이의 기능적 영향을 직접 측정하지 않는다.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"kgvmIqEB6f"}],"key":"Qp3LKxCI9g"}],"key":"gPXf9ui732"}],"key":"n6XzEB92d5"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"strong","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"읽는 법","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"zJGKfzOOAl"}],"key":"XERD7esjls"}],"key":"qTGCLLpsB8"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":8,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"pLDDT 구간별 의미는 모델 문서의 규약을 확인한다. 흔히 70 이상을 비교적 신뢰, 50 미만을 낮은 신뢰로 보지만 ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"E2lrYGXQ9a"},{"type":"strong","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"척도(0~1 vs 0~100)를 먼저 확인","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"yh6oxviKGc"}],"key":"IRGKRVgI0G"},{"type":"text","value":"한다.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"dtpwbojdnU"}],"key":"T6TmF8ywAl"}],"key":"iECnxHbdeO"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"pTM·PAE는 도메인 배치와 전체 폴드의 신뢰도를 다룬다(이 노트북은 pTM, 평균 PAE, PAE 행렬을 출력한다). pLDDT만으로 도메인 상대 배치는 알 수 없다.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"T0kLV8RMDj"}],"key":"vwHAXBezcX"}],"key":"iYIn4w5M7Q"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"단일 서열 모델(ESMFold)은 MSA 기반 모델과 다른 오류 패턴을 보인다. 사전학습 데이터에 포함된 단백질에서는 특히 잘 맞을 수 있다 (평가–사전학습 겹침, 모듈 01).","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"g7SSPRPYnX"}],"key":"iQ9TqDorV0"}],"key":"X4owdbyYbM"}],"key":"of7C0KOcE9"},{"type":"heading","depth":2,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"7. 한계와 과제","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"QP0uKb1MyA"}],"identifier":"id-7","label":"7. 한계와 과제","html_id":"id-7","implicit":true,"key":"UFmtyYIsSd"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":13,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"구조 하나를 정확히 예측한다는 것이 변이 효과, 동역학, 상호작용을 이해한다는 뜻은 아니다.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"CDPtmsC5v6"}],"key":"Yior1cAVL1"}],"key":"SeP7KJULsQ"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"과제: ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"S6RXPK7aRU"},{"type":"link","url":"/protein/exercises","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"모듈 02 과제","key":"FwxHs1aS6Y"}],"urlSource":"../exercises.md","dataUrl":"/
n","value":"import os\nfrom pathlib import Path\nos.environ.setdefault(\"HF_HOME\", str(Path(\".cache/hf\").resolve()))   # it only takes effect if set **before** importing transformers (the same cache as the notebooks; delete the line if you like)\n\nimport numpy as np, torch\nfrom transformers import AutoTokenizer, EsmModel, EsmForMaskedLM\n\nDEVICE = \"mps\" if torch.backends.mps.is_available() else \"cuda\" if torch.cuda.is_available() else \"cpu\"\nNAME = \"facebook/esm2_t6_8M_UR50D\"\nREV = \"c731040fcd8d73dceaa04b0a8e6329b345b0f5df\"                      # pinned with the full sha (do not use a concatenated short prefix)\n\ntok = AutoTokenizer.from_pretrained(NAME, revision=REV)\nenc_model = EsmModel.from_pretrained(NAME, revision=REV, add_pooling_layer=False).to(DEVICE).eval()\nmlm_model = EsmForMaskedLM.from_pretrained(NAME, revision=REV).to(DEVICE).eval()","position":{"start":{"line":8,"column":1},"end":{"line":23,"column":1}},"key":"m1zSfaboSL"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":24,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When opening by repository ID, transformers has pulled in the automatic-conversion files of ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"mAOPwTEVaG"},{"type":"inlineCode","value":"refs/pr/N","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"Xa4xJXMxO8"},{"type":"text","value":" for repositories that have only a ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"PPEGVgnfFJ"},{"type":"inlineCode","value":".bin","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"jSdXUPN9A1"},{"type":"text","value":" (module 05). For a new model, it is safer to run ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"hdMKyBB5y2"},{"type":"inlineCode","value":"from_pretrained","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"nTjgHO0cvo"},{"type":"text","value":" on the ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"xdHrJ1pYzW"},{"type":"strong","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"local path","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"IvnaAOSOGT"}],"key":"eoMnInv1Hl"},{"type":"text","value":" downloaded with ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"aRuvvJAtmU"},{"type":"inlineCode","value":"huggingface_hub.snapshot_download(..., revision=...)","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"bZdtAAw4lh"},{"type":"text","value":".","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"Rm2u9lXTj3"}],"key":"pxtZJHW0Ji"}],"key":"WzNbffrjjw"},{"type":"listItem","spread":true,"position":{"start":{"line":25,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Check the weight license and whether access approval is needed in the model card/metadata before use (module 06 §7).","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"EmHIToU0Lf"}],"key":"RZsHFh3ORY"}],"key":"B7YVnkDV8V"}],"key":"hzEHfLuaLZ"},{"type":"heading","depth":2,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"1. Mean embedding — excluding padding and special tokens","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"oWFW88cIa6"}],"identifier":"id-1-mean-embedding-excluding-padding-and-special-tokens","label":"1. Mean embedding — excluding padding and special tokens","html_id":"id-1-mean-embedding-excluding-padding-and-special-tokens","implicit":true,"key":"Ksmh3CVz18"},{"type":"code","lang":"python","value":"@torch.no_grad()\ndef embed_mean(seqs, layer=-1, batch=32):\n    \"\"\"A (d,) mean embedding per sequence. Padding and <cls>/<eos> are left out of the mean.\n    layer: hidden_states index (0 = embedding-layer output, -1 = last layer).\"\"\"\n    out = []\n    for s in range(0, len(seqs), batch):\n        enc = tok(list(seqs[s:s + batch]), return_tensors=\"pt\", padding=True).to(DEVICE)\n        res = enc_model(**enc, output_hidden_states=True)\n        h = res.hidden_states[layer]                                   # (b, T, d)\n        m = enc[\"attention_mask\"].clone()\n        m[:, 0] = 0                                                    # <cls>\n        m[torch.arange(m.size(0)), enc[\"attention_mask\"].sum(1) - 1] = 0   # <eos>\n        out.append(((h * m.unsqueeze(-1)).sum(1) / m.sum(1, keepdim=True)).cpu())\n    return torch.cat(out).numpy()\n\nseqs = [\"MKTAYIAKQRQISFVKSHFSRQ\", \"MKT\", \"GSHMLEDPVDAFLLRTKQALAESD\"]\nE_batch = embed_mean(seqs)\nE_alone = np.vstack([embed_mean([s]) for s in seqs])\nassert E_batch.shape == (3, enc_model.config.hidden_size)\nassert np.allclose(E_batch, E_alone, atol=1e-4), \"if the batch (with padding) and the single result differ, the mask handling is wrong\"\nprint(\"hidden_size\", E_batch.shape[1], \"| max batch-vs-single difference\", float(np.abs(E_batch - E_alone).max()))","position":{"start":{"line":28,"column":1},"end":{"line":50,"column":1}},"key":"N6QtGGTKk0"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":51,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Always check","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"H7TeIoi2Bn"}],"key":"PGblX5HS7g"},{"type":"text","value":": the result must be the same whether you feed a sequence alone or in a padded batch.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"YyaGITpgux"}],"key":"RPWtAD82jy"}],"key":"zNvLDkXnXG"},{"type":"listItem","spread":true,"position":{"start":{"line":52,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Whether to include ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"TIwYt4Na0R"},{"type":"inlineCode","value":"<cls>","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"tUlybq6af3"},{"type":"text","value":"/","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"vcaoRAYYJO"},{"type":"inlineCode","value":"<eos>","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"hgPAB7KA9V"},{"type":"text","value":" in the mean, and which layer to use instead of the last, should be decided ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"tkUwT7Bx89"},{"type":"strong","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"before seeing the results","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"lwE1F484VJ"}],"key":"yPQ2a93atL"},{"type":"text","value":" or chosen by validation inside the training data (module 07).","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"rXqdlNchVQ"}],"key":"A2P6FEetRy"}],"key":"mQ2W2NyStq"}],"key":"jW4DoJMSNL"},{"type":"heading","depth":2,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"2. Layer choice","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"hyB0rHpb9O"}],"identifier":"id-2-layer-choice","label":"2. Layer choice","html_id":"id-2-layer-choice","implicit":true,"key":"ZXrFJ6ADg3"},{"type":"code","lang":"python","value":"with torch.no_grad():\n    enc = tok(seqs[0], return_tensors=\"pt\").to(DEVICE)\n    hs = enc_model(**enc, output_hidden_states=True).hidden_states\nn_layers = enc_model.config.num_hidden_layers\nassert len(hs) == n_layers + 1                                          # embedding-layer output + one per layer\nprint(\"hidden_states\", len(hs), \"=\", n_layers, \"layers + embedding layer\")","position":{"start":{"line":55,"column":1},"end":{"line":62,"column":1}},"key":"dmaboUjdbh"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":63,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":63,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"In this environment (transformers 5.22.1, ESM-2 8M), ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"EqAomA8KVv"},{"type":"inlineCode","value":"last_hidden_state","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"jvuSuxZSf3"},{"type":"text","value":" was exactly the same as ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"TO6ce4QM7f"},{"type":"inlineCode","value":"hidden_states[-1]","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"bLzawzVKuw"},{"type":"text","value":" (maximum difference 0). It may differ with other models and versions, so check before using it. Notebook 02 used ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"TXET9lJyzz"},{"type":"inlineCode","value":"last_hidden_state","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"lL2CPcMulr"},{"type":"text","value":" when ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"tBQXDl9wFX"},{"type":"inlineCode","value":"layer=-1","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"Q1uIt49naU"},{"type":"text","value":" and ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"i16ftVp7p5"},{"type":"inlineCode","value":"hidden_states[layer]","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"j9W4Fh4uzX"},{"type":"text","value":" otherwise.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"utOsbSL4Va"}],"key":"VZPcWU0eJj"}],"key":"LfW3n5TjXk"}],"key":"B2sHyPH1gW"},{"type":"heading","depth":2,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"3. Residue embedding at the variant position","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"b1B161enME"}],"identifier":"id-3-residue-embedding-at-the-variant-position","label":"3. Residue embedding at the variant position","html_id":"id-3-residue-embedding-at-the-variant-position","implicit":true,"key":"znVwgQ69BR"},{"type":"code","lang":"python","value":"AAS = \"ACDEFGHIKLMNPQRSTVWY\"\n\ndef check_seq(seq, pos1=None):\n    \"\"\"Input checks: the 20 standard residues, the maximum length, the 1-based position range. (Position 0, negative or out-of-range positions silently pick a different token under Python indexing)\"\"\"\n    assert set(seq) <= set(AAS), \"characters other than the 20 standard ones (X, B, Z, U, O, etc.) must be handled separately\"\n    assert len(seq) <= enc_model.config.max_position_embeddings - 2, \"exceeds the maximum length including <cls>/<eos>\"\n    if pos1 is not None:\n        assert 1 <= pos1 <= len(seq), \"pos1 is 1-based and must be in 1..L\"\n\n@torch.no_grad()\ndef residue_embedding(seq, pos1):\n    \"\"\"pos1: 1-based residue position. <cls> is index 0, so token index = pos1.\"\"\"\n    check_seq(seq, pos1)\n    enc = tok(seq, return_tensors=\"pt\").to(DEVICE)\n    h = enc_model(**enc).last_hidden_state[0]\n    return h[pos1].cpu().numpy()\n\nseq = seqs[0]\nassert tok.convert_ids_to_tokens(tok(seq)[\"input_ids\"])[5] == seq[4]    # token 5 = residue 5 (1-based)\nprint(residue_embedding(seq, 5).shape)\nfor bad in (0, -1, len(seq) + 1):\n    try:\n        residue_embedding(seq, bad); raise RuntimeError(\"the check must not pass\")\n    except AssertionError:\n        pass","position":{"start":{"line":66,"column":1},"end":{"line":92,"column":1}},"key":"n8ZxX3gROT"},{"type":"heading","depth":2,"position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"4. Masked-marginal zero-shot score (single substitution)","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"GlgOYRsPT5"}],"identifier":"id-4-masked-marginal-zero-shot-score-single-substitution","label":"4. Masked-marginal zero-shot score (single substitution)","html_id":"id-4-masked-marginal-zero-shot-score-single-substitution","implicit":true,"key":"qX7wilaYq0"},{"type":"code","lang":"python","value":"AA_IDS = torch.tensor(tok.convert_tokens_to_ids(list(AAS)), device=DEVICE)\n\n@torch.no_grad()\ndef masked_marginal_table(seq):\n    \"\"\"An (L, 20) table: the log-probabilities of the 20 amino acids when each position is masked with <mask>.\"\"\"\n    check_seq(seq)\n    ids = tok(seq, return_tensors=\"pt\")[\"input_ids\"].to(DEVICE)         # (1, L+2)\n    L = len(seq)\n    batch = ids.repeat(L, 1)\n    batch[torch.arange(L), torch.arange(L) + 1] = tok.mask_token_id     # mask position i\n    logits = mlm_model(input_ids=batch).logits\n    lp = torch.log_softmax(logits[torch.arange(L), torch.arange(L) + 1].float(), dim=-1)\n    return lp[:, AA_IDS].cpu().numpy()\n\ndef mm_score(table, seq, pos1, mt):\n    check_seq(seq, pos1)\n    wt = seq[pos1 - 1]\n    return table[pos1 - 1, AAS.index(mt)] - table[pos1 - 1, AAS.index(wt)]\n\ntable = masked_marginal_table(seq)\nassert table.shape == (len(seq), 20)\nassert abs(mm_score(table, seq, 5, seq[4])) < 1e-6                     # wt → wt is 0 (a weak check: subtracting the same element from itself)\n# Independent check: the value computed in one go with only position 5 masked must equal the row of the table\nids = tok(seq, return_tensors=\"pt\")[\"input_ids\"].to(DEVICE)\nassert tok.convert_ids_to_tokens(ids[0, 5].item()) == seq[4]           # the token before masking = the residue at position 5\nsingle = ids.clone(); single[0, 5] = tok.mask_token_id\nwith torch.no_grad():\n    lp5 = torch.log_softmax(mlm_model(input_ids=single).logits[0, 5].float(), dim=-1)[AA_IDS].cpu().numpy()\nassert np.allclose(table[4], lp5, atol=1e-4)\nprint(\"e.g. position 5\", seq[4], \"→ A:\", round(float(mm_score(table, seq, 5, \"A\")), 3))","position":{"start":{"line":95,"column":1},"end":{"line":126,"column":1}},"key":"z9R2ZWzdBF"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":127,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The score is a ","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"JhBnP8ST2v"},{"type":"strong","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"proxy","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"HqgsxafJRs"}],"key":"eBIhciFTQ7"},{"type":"text","value":" for “how plausible it is under the natural sequence distribution”. The agreement with actual fitness differs by assay and protein, so confirm it with a benchmark such as ProteinGym (module 02 §4).","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"pxQrbpcLzY"}],"key":"ZLtkVY3qBN"}],"key":"SxYXQvxHy1"},{"type":"listItem","spread":true,"position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"For a lon
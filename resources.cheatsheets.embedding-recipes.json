:"0. 준비 — 리비전 고정과 장치","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jVRpKvjAY1"}],"identifier":"id-0","label":"0. 준비 — 리비전 고정과 장치","html_id":"id-0","implicit":true,"key":"C5LQXOPpjq"},{"type":"code","lang":"python","value":"import os\nfrom pathlib import Path\nos.environ.setdefault(\"HF_HOME\", str(Path(\".cache/hf\").resolve()))   # transformers import **전에** 설정해야 적용된다 (노트북과 같은 캐시; 원하면 줄 삭제)\n\nimport numpy as np, torch\nfrom transformers import AutoTokenizer, EsmModel, EsmForMaskedLM\n\nDEVICE = \"mps\" if torch.backends.mps.is_available() else \"cuda\" if torch.cuda.is_available() else \"cpu\"\nNAME = \"facebook/esm2_t6_8M_UR50D\"\nREV = \"c731040fcd8d73dceaa04b0a8e6329b345b0f5df\"                      # 전체 sha로 고정 (짧은 접두어를 이어 쓰지 말 것)\n\ntok = AutoTokenizer.from_pretrained(NAME, revision=REV)\nenc_model = EsmModel.from_pretrained(NAME, revision=REV, add_pooling_layer=False).to(DEVICE).eval()\nmlm_model = EsmForMaskedLM.from_pretrained(NAME, revision=REV).to(DEVICE).eval()","position":{"start":{"line":6,"column":1},"end":{"line":21,"column":1}},"key":"fz4ptvNYzn"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":22,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"저장소 ID로 열 때 ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"WBsQ2IWKie"},{"type":"inlineCode","value":".bin","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"UgekQLxiYV"},{"type":"text","value":"만 있는 저장소는 transformers가 ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"hDxZY570BE"},{"type":"inlineCode","value":"refs/pr/N","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"s0kLlvtHFq"},{"type":"text","value":"의 자동 변환 파일을 끌어온 적이 있다(모듈 05). 새 모델은 ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"W57GzMHakv"},{"type":"inlineCode","value":"huggingface_hub.snapshot_download(..., revision=...)","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"TKxxWu4Op3"},{"type":"text","value":"로 받은 ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"H3R5ds2nZi"},{"type":"strong","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"로컬 경로","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"zngiS246bm"}],"key":"KPFtmTPObZ"},{"type":"text","value":"에서 ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"GnPVE65WhI"},{"type":"inlineCode","value":"from_pretrained","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"OO9ATIhuc2"},{"type":"text","value":"하는 편이 안전하다.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"DH4yc8GnJk"}],"key":"KcHR9Oq0fl"}],"key":"hq2pZJh3Tv"},{"type":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"가중치 라이선스·접근 승인 여부는 사용 전에 모델 카드/메타데이터로 확인한다 (모듈 06 §7).","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"SqLF6b9zu8"}],"key":"Vuu9fAzJpR"}],"key":"HF0Hqx0Cob"}],"key":"RKZaKYMDuM"},{"type":"heading","depth":2,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"1. 평균 임베딩 — 패딩과 특수 토큰 제외","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"AdR0RitAbI"}],"identifier":"id-1","label":"1. 평균 임베딩 — 패딩과 특수 토큰 제외","html_id":"id-1","implicit":true,"key":"H7SddABdYr"},{"type":"code","lang":"python","value":"@torch.no_grad()\ndef embed_mean(seqs, layer=-1, batch=32):\n    \"\"\"서열마다 (d,) 평균 임베딩. 패딩과 <cls>/<eos>는 평균에서 뺀다.\n    layer: hidden_states 인덱스 (0 = 임베딩 층 출력, -1 = 마지막 층).\"\"\"\n    out = []\n    for s in range(0, len(seqs), batch):\n        enc = tok(list(seqs[s:s + batch]), return_tensors=\"pt\", padding=True).to(DEVICE)\n        res = enc_model(**enc, output_hidden_states=True)\n        h = res.hidden_states[layer]                                   # (b, T, d)\n        m = enc[\"attention_mask\"].clone()\n        m[:, 0] = 0                                                    # <cls>\n        m[torch.arange(m.size(0)), enc[\"attention_mask\"].sum(1) - 1] = 0   # <eos>\n        out.append(((h * m.unsqueeze(-1)).sum(1) / m.sum(1, keepdim=True)).cpu())\n    return torch.cat(out).numpy()\n\nseqs = [\"MKTAYIAKQRQISFVKSHFSRQ\", \"MKT\", \"GSHMLEDPVDAFLLRTKQALAESD\"]\nE_batch = embed_mean(seqs)\nE_alone = np.vstack([embed_mean([s]) for s in seqs])\nassert E_batch.shape == (3, enc_model.config.hidden_size)\nassert np.allclose(E_batch, E_alone, atol=1e-4), \"배치(패딩 포함)와 단독 결과가 다르면 마스크 처리가 틀린 것\"\nprint(\"hidden_size\", E_batch.shape[1], \"| 배치-단독 최대 차이\", float(np.abs(E_batch - E_alone).max()))","position":{"start":{"line":26,"column":1},"end":{"line":48,"column":1}},"key":"aCdE0SIDSL"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":49,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"항상 점검","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"T1rYGHzsoK"}],"key":"loBqHAbVZR"},{"type":"text","value":": 같은 서열을 단독으로 넣을 때와 패딩된 배치로 넣을 때 결과가 같아야 한다.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"vNMF9SeQN8"}],"key":"TpbkAgXkDg"}],"key":"IqJqhu44Rd"},{"type":"listItem","spread":true,"position":{"start":{"line":50,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"평균에 ","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"VcO1xnuAIJ"},{"type":"inlineCode","value":"<cls>","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"HpS1pY8RJW"},{"type":"text","value":"/","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"euoZ1TQkXA"},{"type":"inlineCode","value":"<eos>","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"msEIeZYYqX"},{"type":"text","value":"를 넣을지, 마지막 층 대신 어느 층을 쓸지는 ","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"ftgITeOoPr"},{"type":"strong","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"결과를 보기 전에","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"dJmkJDzKti"}],"key":"YduibzcMXo"},{"type":"text","value":" 정하거나 학습 데이터 안의 검증으로 고른다 (모듈 07).","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"KrQLMnaPyS"}],"key":"WAu6FkfqHw"}],"key":"ecXqLhXVwh"}],"key":"Broce3McBz"},{"type":"heading","depth":2,"position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"2. 층 선택","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"HFscZCztMa"}],"identifier":"id-2","label":"2. 층 선택","html_id":"id-2","implicit":true,"key":"mr7bcYwjIJ"},{"type":"code","lang":"python","value":"with torch.no_grad():\n    enc = tok(seqs[0], return_tensors=\"pt\").to(DEVICE)\n    hs = enc_model(**enc, output_hidden_states=True).hidden_states\nn_layers = enc_model.config.num_hidden_layers\nassert len(hs) == n_layers + 1                                          # 임베딩 층 출력 + 층마다 하나\nprint(\"hidden_states\", len(hs), \"개 =\", n_layers, \"층 + 임베딩 층\")","position":{"start":{"line":53,"column":1},"end":{"line":60,"column":1}},"key":"Cfp2VW8gVN"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":61,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":61,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"이 환경(transformers 5.22.1, ESM-2 8M)에서는 ","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"M2Xlfd5Cd7"},{"type":"inlineCode","value":"last_hidden_state","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"raeHgPGlEK"},{"type":"text","value":"가 ","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"ZQVGR3geiO"},{"type":"inlineCode","value":"hidden_states[-1]","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"EVrLwDTYDq"},{"type":"text","value":"과 정확히 같았다(최대 차이 0). 다른 모델·버전에서는 다를 수 있으니 확인하고 쓴다. 노트북 02는 ","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"hc837vj1TS"},{"type":"inlineCode","value":"layer=-1","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"EXE6odrhSW"},{"type":"text","value":"일 때 ","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"coeEjC2YED"},{"type":"inlineCode","value":"last_hidden_state","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"HYNJEDI4g6"},{"type":"text","value":", 아니면 ","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"ULno3k5RQi"},{"type":"inlineCode","value":"hidden_states[layer]","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"uvUlzCiHoy"},{"type":"text","value":"를 썼다.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"l9C0bD4HzT"}],"key":"iXZypNssoD"}],"key":"CdGZ4uZGEs"}],"key":"wqC2kDRaZX"},{"type":"heading","depth":2,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"3. 변이 위치의 잔기 임베딩","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"JL8tpXiz5b"}],"identifier":"id-3","label":"3. 변이 위치의 잔기 임베딩","html_id":"id-3","implicit":true,"key":"BhI759Cw3k"},{"type":"code","lang":"python","value":"AAS = \"ACDEFGHIKLMNPQRSTVWY\"\n\ndef check_seq(seq, pos1=None):\n    \"\"\"입력 점검: 표준 20종, 최대 길이, 1-based 위치 범위. (0·음수·범위 밖 위치는 파이썬 인덱싱이 조용히 다른 토큰을 고른다)\"\"\"\n    assert set(seq) <= set(AAS), \"표준 20종 이외의 문자(X, B, Z, U, O 등)는 따로 처리해야 한다\"\n    assert len(seq) <= enc_model.config.max_position_embeddings - 2, \"<cls>/<eos>를 포함한 최대 길이 초과\"\n    if pos1 is not None:\n        assert 1 <= pos1 <= len(seq), \"pos1은 1-based이며 1..L 이어야 한다\"\n\n@torch.no_grad()\ndef residue_embedding(seq, pos1):\n    \"\"\"pos1: 1-based 잔기 위치. <cls>가 인덱스 0이므로 토큰 인덱스 = pos1.\"\"\"\n    check_seq(seq, pos1)\n    enc = tok(seq, return_tensors=\"pt\").to(DEVICE)\n    h = enc_model(**enc).last_hidden_state[0]\n    return h[pos1].cpu().numpy()\n\nseq = seqs[0]\nassert tok.convert_ids_to_tokens(tok(seq)[\"input_ids\"])[5] == seq[4]    # 토큰 5 = 잔기 5 (1-based)\nprint(residue_embedding(seq, 5).shape)\nfor bad in (0, -1, len(seq) + 1):\n    try:\n        residue_embedding(seq, bad); raise RuntimeError(\"점검이 통과해서는 안 된다\")\n    except AssertionError:\n        pass","position":{"start":{"line":64,"column":1},"end":{"line":90,"column":1}},"key":"ST365TxCLM"},{"type":"heading","depth":2,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"4. Masked-marginal zero-shot 점수 (단일 치환)","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"otCUwJzYaU"}],"identifier":"id-4-masked-marginal-zero-shot","label":"4. Masked-marginal zero-shot 점수 (단일 치환)","html_id":"id-4-masked-marginal-zero-shot","implicit":true,"key":"GTyVjUN8HA"},{"type":"code","lang":"python","value":"AA_IDS = torch.tensor(tok.convert_tokens_to_ids(list(AAS)), device=DEVICE)\n\n@torch.no_grad()\ndef masked_marginal_table(seq):\n    \"\"\"(L, 20) 표: 각 위치를 <mask>로 가렸을 때 20개 아미노산의 log-확률.\"\"\"\n    check_seq(seq)\n    ids = tok(seq, return_tensors=\"pt\")[\"input_ids\"].to(DEVICE)         # (1, L+2)\n    L = len(seq)\n    batch = ids.repeat(L, 1)\n    batch[torch.arange(L), torch.arange(L) + 1] = tok.mask_token_id     # 위치 i를 가림\n    logits = mlm_model(input_ids=batch).logits\n    lp = torch.log_softmax(logits[torch.arange(L), torch.arange(L) + 1].float(), dim=-1)\n    return lp[:, AA_IDS].cpu().numpy()\n\ndef mm_score(table, seq, pos1, mt):\n    check_seq(seq, pos1)\n    wt = seq[pos1 - 1]\n    return table[pos1 - 1, AAS.index(mt)] - table[pos1 - 1, AAS.index(wt)]\n\ntable = masked_marginal_table(seq)\nassert table.shape == (len(seq), 20)\nassert abs(mm_score(table, seq, 5, seq[4])) < 1e-6                     # wt → wt 는 0 (약한 점검: 같은 원소끼리 뺀 값)\n# 독립 점검: 위치 5만 따로 가려 한 번에 계산한 값이 표의 행과 같아야 한다\nids = tok(seq, return_tensors=\"pt\")[\"input_ids\"].to(DEVICE)\nassert tok.convert_ids_to_tokens(ids[0, 5].item()) == seq[4]           # 가리기 전 토큰 = 위치 5의 잔기\nsingle = ids.clone(); single[0, 5] = tok.mask_token_id\nwith torch.no_grad():\n    lp5 = torch.log_softmax(mlm_model(input_ids=single).logits[0, 5].float(), dim=-1)[AA_IDS].cpu().numpy()\nassert np.allclose(table[4], lp5, atol=1e-4)\nprint(\"예: 위치 5\", seq[4], \"→ A:\", round(float(mm_score(table, seq, 5, \"A\")), 3))","position":{"start":{"line":93,"column":1},"end":{"line":124,"column":1}},"key":"LdzCxtqEXC"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":125,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"점수는 \"자연 서열 분포에서 얼마나 그럴듯한가\"의 ","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"NUXuQHr7SP"},{"type":"strong","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"children":[{"type":
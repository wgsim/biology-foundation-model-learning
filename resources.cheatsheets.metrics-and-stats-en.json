-2-constant-prediction-and-spearman","implicit":true,"key":"w8TrVS68AN"},{"type":"code","lang":"python","value":"rng = np.random.default_rng(0)\ny = rng.normal(size=50)\nconst = np.zeros(50)\nwith warnings.catch_warnings():\n    warnings.simplefilter(\"ignore\")                # ConstantInputWarning\n    rho_const = spearmanr(const, y).statistic\nassert np.isnan(rho_const)                 # the Spearman of a constant prediction is undefined (NaN)\nassert roc_auc_score(np.r_[0, 1, 0, 1], np.zeros(4)) == 0.5     # AUROC, on the other hand, counts ties as 1/2, so it gives a constant prediction 0.5 (the two metrics behave differently on constant input)","position":{"start":{"line":25,"column":1},"end":{"line":34,"column":1}},"key":"q5XkjKOMyL"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":35,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":35,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Do not replace an undefined value with −1 or 0 and put it in the average.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"OvXKJR0DL5"}],"key":"Jpko5MoUS6"},{"type":"text","value":" Record it as NaN and report the number of excluded seeds together (module 07 template: the mean prediction of the nearest train position became nearly constant at new positions, so the ρ of one seed was NaN). Replace NaN with the worst value only in the internal score used for hyperparameter selection.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"nx6STQaZ8G"}],"key":"vib4o2kGlz"}],"key":"R82e8VsZtX"}],"key":"mc6mz7Udg2"},{"type":"heading","depth":2,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"3. AUROC — compute per fold and average","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"mmeO0exFn8"}],"identifier":"id-3-auroc-compute-per-fold-and-average","label":"3. AUROC — compute per fold and average","html_id":"id-3-auroc-compute-per-fold-and-average","implicit":true,"key":"lXhc6tQFfD"},{"type":"code","lang":"python","value":"# Two models that output a different constant in each fold: neither has any discriminative power in any fold. (roc_auc_score gives 0.5 for constant input)\ny1 = np.array([0, 1] * 10); p1 = np.full(20, 0.2)\ny2 = np.array([0, 1] * 10); p2 = np.full(20, 0.8)\nper_fold = np.mean([roc_auc_score(y1, p1), roc_auc_score(y2, p2)])\npooled = roc_auc_score(np.r_[y1, y2], np.r_[p1, p2])\nassert per_fold == 0.5\nassert pooled == 0.5                       # balanced + the same ratio in both folds, so it is 0.5 by coincidence\n# If the positive fraction differs by fold, pooling moves even a constant prediction away from 0.5.\ny3 = np.array([0] * 18 + [1] * 2);  p3 = np.full(20, 0.2)     # 10% positives, low score\ny4 = np.array([0] * 2 + [1] * 18);  p4 = np.full(20, 0.8)     # 90% positives, high score\nper_fold2 = np.mean([roc_auc_score(y3, p3), roc_auc_score(y4, p4)])\npooled2 = roc_auc_score(np.r_[y3, y4], np.r_[p3, p4])\nassert per_fold2 == 0.5 and abs(pooled2 - 0.9) < 1e-9     # a constant prediction, yet 0.9 when pooled\nprint(\"per-fold mean\", per_fold2, \"| pooled\", round(pooled2, 3))","position":{"start":{"line":38,"column":1},"end":{"line":53,"column":1}},"key":"zB0di5bNww"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":54,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The score scale can differ for each fold model, so ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"Wb2Ypb7qDP"},{"type":"strong","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"report the per-fold AUROC first","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"vrVz21CkWN"}],"key":"vQI37ymzke"},{"type":"text","value":". An out-of-fold AUROC that pools the scores is a ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"WSKZMmfWd1"},{"type":"emphasis","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"different estimand","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"e4UKz9lLM3"}],"key":"oKRvQQeApy"},{"type":"text","value":" (a value that also mixes in the difference of scales between folds), so if you use it, define it that way and report it together with the per-fold values. While building module 05, a pooled AUROC once came out below 0.5 (0.460). That is an observation made during development, and the final notebook uses the per-fold mean.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"K4BVp1lJN5"}],"key":"HhfQ2b8dup"}],"key":"Ko0sb8dr5k"}],"key":"gwblx1RBwi"},{"type":"heading","depth":2,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"4. The random baseline of AUPRC ≈ the positive fraction","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"SVIydswNnu"}],"identifier":"id-4-the-random-baseline-of-auprc-the-positive-fraction","label":"4. The random baseline of AUPRC ≈ the positive fraction","html_id":"id-4-the-random-baseline-of-auprc-the-positive-fraction","implicit":true,"key":"xJy2nXpC9y"},{"type":"code","lang":"python","value":"rng = np.random.default_rng(1)\ny = (rng.random(20000) < 0.10).astype(int)       # 10% positives\nap = average_precision_score(y, rng.random(20000))\nassert abs(ap - y.mean()) < 0.01\nprint(\"random AUPRC\", round(ap, 3), \"positive fraction\", round(y.mean(), 3))","position":{"start":{"line":57,"column":1},"end":{"line":63,"column":1}},"key":"awTgZeIY3I"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":64,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"average_precision_score","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"dau0mKlouO"},{"type":"text","value":" is the ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"hzlxfWFjqd"},{"type":"strong","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"average precision (AP)","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"PvsAP5V8my"}],"key":"V5APT7iRAI"},{"type":"text","value":" of a step-wise integral, and differs slightly from the trapezoidal area of the PR curve. The positive fraction is an ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"PDyTXdk518"},{"type":"emphasis","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"approximate","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"spispPSnvo"}],"key":"FGuQ2qjHau"},{"type":"text","value":" baseline for large samples and is not exactly equal to the expected AP in a finite sample. It fluctuates more in a subset with few positives (e.g., 21 positives). So report the ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"ZCw7O961RA"},{"type":"strong","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"permutation distribution","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"MWtG0b0oxr"}],"key":"j19PMFT339"},{"type":"text","value":" of the random score together (module 03: TraitGym).","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"RGR3P9iHi9"}],"key":"OwpxixHuVb"}],"key":"Uo5qhK78Hj"}],"key":"iEFtShGlx2"},{"type":"heading","depth":2,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"5. Tie handling in retrieval metrics — against the correct answer","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"qwlFfg1bY6"}],"identifier":"id-5-tie-handling-in-retrieval-metrics-against-the-correct-answer","label":"5. Tie handling in retrieval metrics — against the correct answer","html_id":"id-5-tie-handling-in-retrieval-metrics-against-the-correct-answer","implicit":true,"key":"M5HxP8xUOC"},{"type":"code","lang":"python","value":"def rank_of_truth(scores, true_idx, decimals=6):\n    \"\"\"The rank of the correct answer (1 is the best). Other items with the same score as the correct one are counted as ahead of it (ties-against-truth).\"\"\"\n    s = np.round(np.asarray(scores, dtype=float), decimals)\n    better = (s > s[true_idx]).sum()\n    tied_others = ((s == s[true_idx]).sum()) - 1\n    return int(better + tied_others + 1)\n\nscores = np.array([0.9, 0.9, 0.9, 0.1])             # duplicate items that all gave the same score\nassert rank_of_truth(scores, 0) == 3                # using only a strict '>' inflates it to rank 1\nstrict = int((scores > scores[0]).sum() + 1)\nassert strict == 1\nprint(\"strict '>' rank\", strict, \"| ties-against-truth\", rank_of_truth(scores, 0))","position":{"start":{"line":67,"column":1},"end":{"line":80,"column":1}},"key":"p6D6TTTjuP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Decide the tie rule ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"IgV74GIeRt"},{"type":"strong","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"in advance","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"PGQUZr8X7V"}],"key":"Qjv6ud5s1D"},{"type":"text","value":" and report it. If duplicate items (the same text or sequence) are in the gallery, a strict ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"XFfdgE5PiZ"},{"type":"inlineCode","value":">","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"Kun5jBcDq6"},{"type":"text","value":" greatly inflates the nearest-neighbor baseline (module 05: R@1 by 1.5–2.3 times). Rounding the scores removes fake orderings caused by floating-point noise. The number of rounding digits (","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"ryEGtEWYtj"},{"type":"inlineCode","value":"decimals","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"ZDkUXebDn2"},{"type":"text","value":") is ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"Or7ehIiflb"},{"type":"strong","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"decided and reported in advance","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"s7Qza8owDH"}],"key":"hARlBOUDsa"},{"type":"text","value":". Rounding can actually turn different scores into ties and may split at a boundary, so check whether the result changes at other numbers of digits.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"qMrQ8fdoKa"}],"key":"uTIWSNxLpv"}],"key":"AxjNcUZOJs"}],"key":"u4zRgcV8t3"},{"type":"heading","depth":2,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"6. Paired comparison + group bootstrap","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"TnRwkUfS97"}],"identifier":"id-6-paired-comparison-group-bootstrap","label":"6. Paired comparison + group bootstrap","html_id":"id-6-paired-comparison-group-bootstrap","implicit":true,"key":"iN3QEhz4Xo"},{"type":"code","lang":"python","value":"def paired_delta_by_group(y, p1, p2, groups, metric=lambda a, b: spearmanr(a, b).statistic,\n                          n_boot=1000, min_groups=8, seed=0):\n    \"\"\"Δ = metric(y, p1) − metric(y, p2). A conditional interval that resamples the correlation unit (groups) with replacement.\n    If there are fewer than min_groups clusters, it does not compute the interval and returns None.\"\"\"\n    y, p1, p2, groups = map(np.asarray, (y, p1, p2, groups))\n    delta = metric(y, p1) - metric(y, p2)          # estimand: the difference of the pooled row-level metric (larger clusters are reflected more)\n    ug = np.unique(groups)\n    if len(ug) < min_groups:\n        return delta, None\n    idx_by_g = {g: np.flatnonzero(groups == g) for g in ug}\n    rng = np.random.default_rng(seed)\n    out = []\n    for _ in range(n_boot):\n        pick = rng.choice(ug, size=len(ug), replace=True)\n        ii = np.concatenate([idx_by_g[g] for g in pick])\n        with warnings.catch_warnings():\n            warnings.simplefilter(\"ignore\")\n            d = metric(y[ii], p1[ii]) - metric(y[ii], p2[ii])\n        if np.isfinite(d):\n            out.append(d)\n    if len(out) < 0.9 * n_boot:                    # if many resamples are undefined, do not give an interval\n        return delta, None\n    return delta, (float(np.percentile(out, 2.5)), float(np.percentile(out, 97.5)))\n\n# Synthetic self-check: 40 clusters, 20 rows per cluster\nrng = np.random.default_rng(2)\nG = np.repeat(np.arange(40), 20)\ny = rng.normal(size=800) + np.repeat(rng.normal(size=40), 20)\nsame_a = y + rng.normal(scale=1.0, size=800)\nsame_b = y + rng.normal(scale=1.0, size=800)\nbetter = y + rng.normal(scale=0.3, size=800)\nd0, ci0 = paired_delta_by_group(y, same_a, same_b, G)\nd1, ci1 = paired_delta_by_group(y, better, same_b, G)\nassert ci0[0] < 0 < ci0[1]                 # at the same level, the interval includes 0\nassert ci1[0] > 0                          # when much more accurate, it does not include 0\nassert paired_delta_by_group(y[:40], better[:40], same_b[:40], G[:40] // 20)[1] is None   # 2 clusters → not computed\nprint(\"same level:\", round(d0, 3), [round(v, 3) for v in ci0], \"| more accurate:\", round(d1, 3), [round(v, 3) for v in ci1])","position":{"start":{"line":84,"column":1},"end":{"line":122,"column":1}},"key":"X5YeJna99d"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":123,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"Conditional interval","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"yJ2vy5Sv9G"}],"key":"vMERFBtnN9"},{"type":"text","value":": with the training and seeds fixed, only the test clusters are redrawn. State that the variation from training and from model initialization is not reflected.","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"q0CWVx32xR"}],"key":"XXskZLKgFA"}],"key":"v0haUwy3Y3"},{"type":"listItem","spread":true,"position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The estimand of the function above is ","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"t7ZYoqnDdb"},{"type":"emphasis","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"children
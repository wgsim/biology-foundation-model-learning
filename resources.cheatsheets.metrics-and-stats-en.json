column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"7. The decision rule as a function","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"SelAOKYSaZ"}],"identifier":"id-7-the-decision-rule-as-a-function","label":"7. The decision rule as a function","html_id":"id-7-the-decision-rule-as-a-function","implicit":true,"key":"PmzxsFnH4h"},{"type":"code","lang":"python","value":"def decide(deltas, ci=None, min_effect=0.02, min_wins=4):\n    \"\"\"Per-seed Δ (model − baseline) → 'supported' / 'not supported'. Fix the rule in code before seeing the results.\"\"\"\n    d = np.asarray([x for x in deltas if np.isfinite(x)])\n    if len(d) == 0:\n        return \"판정 불가\"\n    ok = d.mean() >= min_effect and (d > 0).sum() >= min_wins\n    if ci is not None:\n        ok = ok and ci[0] > 0\n    return \"지지\" if ok else \"지지되지 않음\"\n\nassert decide([0.05, 0.04, 0.06, 0.03, 0.05]) == \"지지\"\nassert decide([0.05, 0.04, -0.06, 0.03, -0.05]) == \"지지되지 않음\"\nassert decide([np.nan, np.nan]) == \"판정 불가\"","position":{"start":{"line":130,"column":1},"end":{"line":144,"column":1}},"key":"yrpV3QqHOo"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":145,"column":1},"end":{"line":146,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":145,"column":1},"end":{"line":146,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The thresholds (0.02, 4/5) are for the demonstration in this course. In a real project, decide a ","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"TKTQxvRtIl"},{"type":"strong","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"children":[{"type":"text","value":"meaningful effect size","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"oUnm2yJygE"}],"key":"iGctY4XtaN"},{"type":"text","value":" in advance, with grounds.","position":{"start":{"line":
sition":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"MPCiWtZQwx"}],"key":"Gxie8IuBEG"},{"type":"text","value":" 기준이고 유한 표본의 기대 AP와 정확히 같지는 않다. 양성이 적은 부분집합(예: 양성 21개)에서는 더 흔들린다. 그래서 무작위 점수의 ","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"IkPaiwfXUM"},{"type":"strong","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"순열 분포","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"UkFKI9jcCI"}],"key":"GRm6Lji3MJ"},{"type":"text","value":"를 함께 보고한다 (모듈 03: TraitGym).","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"yse5Y2kuSc"}],"key":"tR5aLEFV4N"}],"key":"SlxQLHdpWe"}],"key":"cjinIWVqeO"},{"type":"heading","depth":2,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"5. 검색 지표의 동점 처리 — 정답에 불리하게","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"z12jx5E2s7"}],"identifier":"id-5","label":"5. 검색 지표의 동점 처리 — 정답에 불리하게","html_id":"id-5","implicit":true,"key":"liIvMqdvMg"},{"type":"code","lang":"python","value":"def rank_of_truth(scores, true_idx, decimals=6):\n    \"\"\"정답의 순위(1이 최고). 정답과 점수가 같은 다른 항목은 정답보다 앞선 것으로 센다 (ties-against-truth).\"\"\"\n    s = np.round(np.asarray(scores, dtype=float), decimals)\n    better = (s > s[true_idx]).sum()\n    tied_others = ((s == s[true_idx]).sum()) - 1\n    return int(better + tied_others + 1)\n\nscores = np.array([0.9, 0.9, 0.9, 0.1])             # 모두 같은 점수를 낸 중복 항목들\nassert rank_of_truth(scores, 0) == 3                # 엄격한 '>'만 쓰면 1위로 부풀려진다\nstrict = int((scores > scores[0]).sum() + 1)\nassert strict == 1\nprint(\"엄격 '>' 순위\", strict, \"| ties-against-truth\", rank_of_truth(scores, 0))","position":{"start":{"line":65,"column":1},"end":{"line":78,"column":1}},"key":"qMSKOOC0Q1"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":79,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":79,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"동점 규칙을 ","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"ayTNC6AYV0"},{"type":"strong","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"미리 정해","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"kgqG51IRk2"}],"key":"OO4Bz2smny"},{"type":"text","value":" 보고한다. 중복 항목(같은 텍스트·서열)이 갤러리에 있으면 엄격한 ","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"YsXXt02wlE"},{"type":"inlineCode","value":">","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"ms73Lx7yuc"},{"type":"text","value":"는 최근접 이웃 baseline을 크게 부풀린다 (모듈 05: R@1이 1.5~2.3배). 점수를 반올림해 부동소수점 잡음에 의한 가짜 순서를 없앤다. 반올림 자릿수(","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"zRg9dUX8g9"},{"type":"inlineCode","value":"decimals","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"bKrcAUqzfk"},{"type":"text","value":")는 ","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"JHqTHsb1sb"},{"type":"strong","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"미리 정해 보고","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"Lda33lAZLa"}],"key":"hh3hffdfAJ"},{"type":"text","value":"한다. 반올림은 실제로 다른 점수를 동점으로 만들 수 있고 경계에서 갈릴 수도 있으므로, 다른 자릿수에서 결과가 바뀌는지 확인한다.","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"olTmhI2eZS"}],"key":"LIojqxOXYB"}],"key":"epoiUpH7v7"}],"key":"tz3OjVNGzq"},{"type":"heading","depth":2,"position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"6. 짝지은 비교 + 그룹 부트스트랩","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"VpPFqJn6xv"}],"identifier":"id-6","label":"6. 짝지은 비교 + 그룹 부트스트랩","html_id":"id-6","implicit":true,"key":"ngaDMszhsE"},{"type":"code","lang":"python","value":"def paired_delta_by_group(y, p1, p2, groups, metric=lambda a, b: spearmanr(a, b).statistic,\n                          n_boot=1000, min_groups=8, seed=0):\n    \"\"\"Δ = metric(y, p1) − metric(y, p2). 상관 단위(groups)를 복원추출하는 조건부 구간.\n    군집이 min_groups 미만이면 구간을 계산하지 않고 None을 돌려준다.\"\"\"\n    y, p1, p2, groups = map(np.asarray, (y, p1, p2, groups))\n    delta = metric(y, p1) - metric(y, p2)          # 추정 대상: 풀링한 행 단위 지표의 차이 (군집이 크면 더 많이 반영된다)\n    ug = np.unique(groups)\n    if len(ug) < min_groups:\n        return delta, None\n    idx_by_g = {g: np.flatnonzero(groups == g) for g in ug}\n    rng = np.random.default_rng(seed)\n    out = []\n    for _ in range(n_boot):\n        pick = rng.choice(ug, size=len(ug), replace=True)\n        ii = np.concatenate([idx_by_g[g] for g in pick])\n        with warnings.catch_warnings():\n            warnings.simplefilter(\"ignore\")\n            d = metric(y[ii], p1[ii]) - metric(y[ii], p2[ii])\n        if np.isfinite(d):\n            out.append(d)\n    if len(out) < 0.9 * n_boot:                    # 정의되지 않은 재표본이 많으면 구간을 내지 않는다\n        return delta, None\n    return delta, (float(np.percentile(out, 2.5)), float(np.percentile(out, 97.5)))\n\n# 합성 자체 점검: 40개 군집, 군집마다 20개 행\nrng = np.random.default_rng(2)\nG = np.repeat(np.arange(40), 20)\ny = rng.normal(size=800) + np.repeat(rng.normal(size=40), 20)\nsame_a = y + rng.normal(scale=1.0, size=800)\nsame_b = y + rng.normal(scale=1.0, size=800)\nbetter = y + rng.normal(scale=0.3, size=800)\nd0, ci0 = paired_delta_by_group(y, same_a, same_b, G)\nd1, ci1 = paired_delta_by_group(y, better, same_b, G)\nassert ci0[0] < 0 < ci0[1]                 # 같은 수준이면 구간이 0을 포함\nassert ci1[0] > 0                          # 훨씬 정확하면 0을 포함하지 않음\nassert paired_delta_by_group(y[:40], better[:40], same_b[:40], G[:40] // 20)[1] is None   # 군집 2개 → 계산 안 함\nprint(\"같은 수준:\", round(d0, 3), [round(v, 3) for v in ci0], \"| 더 정확:\", round(d1, 3), [round(v, 3) for v in ci1])","position":{"start":{"line":82,"column":1},"end":{"line":120,"column":1}},"key":"mEFEeCdgdN"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":121,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"조건부 구간","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"bFhzzAs6kp"}],"key":"xxRMpYahtG"},{"type":"text","value":": 고정된 학습·시드를 두고 test 군집만 다시 뽑는다. 학습 변동·모델 초기화 변동은 반영하지 않는다고 적는다.","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"SOADHHQkW2"}],"key":"td0sE4Dufx"}],"key":"hHBHlCGJYW"},{"type":"listItem","spread":true,"position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"위 함수의 추정 대상은 ","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"L4SeCzhf9p"},{"type":"emphasis","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"text","value":"재표본된 행을 풀링한 지표","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"luZ8QsoJQm"}],"key":"PV3mIh6xRe"},{"type":"text","value":"다(점수 눈금이 같은 한 모델의 예측을 같은 행에서 비교하므로 §3의 폴드 풀링 문제와는 다르다). 군집 크기가 매우 다르고 ","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"pjBBx7rhGt"},{"type":"strong","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"text","value":"군집별 지표의 평균","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"SWEbBVDjBK"}],"key":"fJ
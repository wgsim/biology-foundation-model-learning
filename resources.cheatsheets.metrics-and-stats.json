ue":"독립 반복이 아니다","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"IMC42iJSnN"}],"key":"l0J6oUPRva"},{"type":"text","value":". 분할 민감도를 보는 것이다.","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"uwyUYj4eUF"}],"key":"lhyvG7N69O"}],"key":"bZpVJ8nndY"},{"type":"listItem","spread":true,"position":{"start":{"line":125,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"\"중앙값의 차이\"와 \"차이의 중앙값\"은 다르다. 짝지은 비교는 후자(차이를 먼저 구한다).","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"ao3lL7Zuwf"}],"key":"gdcxJtuD25"}],"key":"eS4jDOC2gm"}],"key":"zk74kh3xXv"},{"type":"heading","depth":2,"position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"7. 결정 규칙을 함수로","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"gBgjGBbE1l"}],"identifier":"id-7","label":"7. 결정 규칙을 함수로","html_id":"id-7","implicit":true,"key":"Gi6w9cqAmU"},{"type":"code","lang":"python","value":"def decide(deltas, ci=None, min_effect=0.02, min_wins=4):\n    \"\"\"시드별 Δ(모델 − baseline) → '지지' / '지지되지 않음'. 규칙은 결과를 보기 전에 정해 코드에 고정한다.\"\"\"\n    d = np.asarray([x for x in deltas if np.isfinite(x)])\n    if len(d) == 0:\n        return \"판정 불가\"\n    ok = d.mean() >= min_effect and (d > 0).sum() >= min_wins\n    if ci is not None:\n        ok = ok and ci[0] > 0\n    return \"지지\" if ok else \"지지되지 않음\"\n\nassert decide([0.05, 0.04, 0.06, 0.03, 0.05]) == \"지지\"\nassert decide([0.05, 0.04, -0.06, 0.03, -0.05]) == \"지지되지 않음\"\nassert decide([np.nan, np.nan]) == \"판정 불가\"","position":{"start":{"line":128,"column":1},"end":{"line":142,"column":1}},"key":"Jc1OM41Qil"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":143,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":143,"column":1},"end":{"line":144,"column"
oc_auc_score(y2, p2)])\npooled = roc_auc_score(np.r_[y1, y2], np.r_[p1, p2])\nassert per_fold == 0.5\nassert pooled == 0.5                       # 균형 + 양 폴드 같은 비율이라 우연히 0.5\n# 폴드마다 양성 비율이 다르면 풀링은 상수 예측도 0.5에서 벗어난다.\ny3 = np.array([0] * 18 + [1] * 2);  p3 = np.full(20, 0.2)     # 양성 10%, 낮은 점수\ny4 = np.array([0] * 2 + [1] * 18);  p4 = np.full(20, 0.8)     # 양성 90%, 높은 점수\nper_fold2 = np.mean([roc_auc_score(y3, p3), roc_auc_score(y4, p4)])\npooled2 = roc_auc_score(np.r_[y3, y4], np.r_[p3, p4])\nassert per_fold2 == 0.5 and abs(pooled2 - 0.9) < 1e-9     # 상수 예측인데 풀링하면 0.9\nprint(\"폴드별 평균\", per_fold2, \"| 풀링\", round(pooled2, 3))","position":{"start":{"line":36,"column":1},"end":{"line":51,"column":1}},"key":"Vg4RJ5u1kW"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":52,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":52,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"폴드 모델마다 점수 눈금이 다를 수 있으므로 ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"qMz6oX2Ou6"},{"type":"strong","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"폴드별 AUROC를 우선 보고","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"pxUeFDl3kA"}],"key":"sB0WplUQz0"},{"type":"text","value":"한다. 점수를 풀링한 out-of-fold AUROC는 ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"omUPNzAKmP"},{"type":"emphasis","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"다른 추정 대상","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"YjItsaPkf0"}],"key":"D3c4vW7zAO"},{"type":"text","value":"(폴드 간 눈금 차이까지 섞인 값)이므로 쓰려면 그렇게 정의하고 폴드별 값과 함께 낸다. 모듈 05를 만들던 중 풀링한 AUROC가 0.5 아래(0.460)로 나온 적이 있다. 개발 중 관측이며, 최종 노트북은 폴드별 평균을 쓴다.","position":{"start":{"line":52,"
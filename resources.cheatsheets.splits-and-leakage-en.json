ict(zip(cl.member, cl.rep))\ngroups = np.array([group_of[s] for s in seq_ids])\ntr, te = GroupShuffleSplit(1, test_size=0.4, random_state=1).split(seq_ids, groups=groups).__next__()\nassert set(groups[tr]).isdisjoint(set(groups[te]))      # the same cluster goes to only one side\nprint(\"train\", [seq_ids[i] for i in tr], \"| test\", [seq_ids[i] for i in te])","position":{"start":{"line":66,"column":1},"end":{"line":79,"column":1}},"key":"bk6NQ5RDCI"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":80,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"Ch0ys1DSIq"},{"type":"strong","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"lower","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"YwdxQUZTah"}],"key":"lxtpAVMXFk"},{"type":"text","value":" ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"gLvGIgJNnE"},{"type":"inlineCode","value":"--min-seq-id","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"CjdVwfjRCB"},{"type":"text","value":" is (e.g., 0.3 < 0.9), the larger the clusters and the stricter the split. ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"hJSJgvkPdE"},{"type":"strong","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Report the threshold and the coverage options (","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"DH5H6C9Q08"},{"type":"inlineCode","value":"-c","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"sFZQV6NU21"},{"type":"text","value":", ","position":{"start"
Jwp0yaf"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"2. Position-block split + leakage numbers (variant data)","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"yN0PYaaQpv"}],"identifier":"id-2-position-block-split-leakage-numbers-variant-data","label":"2. Position-block split + leakage numbers (variant data)","html_id":"id-2-position-block-split-leakage-numbers-variant-data","implicit":true,"key":"MQswL3Uazx"},{"type":"code","lang":"python","value":"import numpy as np\nfrom sklearn.model_selection import GroupShuffleSplit\n\nrng = np.random.default_rng(0)\nL = 120\npos = rng.integers(1, L + 1, size=1000)                  # the positions of 1000 variants (1-based)\n\ndef block_groups(pos, block=10):\n    return (np.asarray(pos) - 1) // block               # `block` consecutive positions form one group\n\ndef leakage_report(pos, groups, train_idx, test_idx):\n    \"\"\"groups: the group array actually used for the split (one per row for a random split).\"\"\"\n    tr_pos, te_pos = set(pos[train_idx]), pos[test_idx]\n    in_train = float(np.mean([p in tr_pos for p in te_pos]))\n    trp = np.array(sorted(tr_pos))\n    dist = np.array([np.abs(trp - p).min() for p in te_pos])\n    return dict(test_frac=len(test_idx) / (len(train_idx) + len(test_idx)),\n                test_pos_in_train=in_train, median_dist_to_train=float(np.median(dist)),\n                n_test_positions=len(set(te_pos)), n_test_groups=len(np.unique(np.asarray(groups)[test_idx])))\n\nidx = np.arange(len(pos))\n# (a) Random split: other substitutions at the same position are in train\ntr, te = GroupShuffleSplit(1, test_size=0.2, random_state=0).split(idx, groups=idx).__next__()\nrand = leakage_report(pos, idx, tr, te)\n# (b) Position-block split\ntr, te = GroupShuffleSplit(1, test_size=0.2, random_state=0).split(idx, groups=block_groups(pos)).__next__()\nblk = leakage_report(pos, block_groups(pos), tr, te)\nassert rand[\"test_pos_in_train\"] > 0.95 and blk[\"test_pos_in_train\"] == 0.0\nassert blk[\"median_dist_to_train\"] >= 1\nprint(\"random:\", {k: round(v, 2) for k, v in rand.items()})\nprint(\"block :\", {k: round(v, 2) for k, v in blk.items()})","position":{"start":{"line":22,"column":1},"end":{"line":54,"column":1}},"key":"Ut62clNfIe"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":55,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The block split blocks the ","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"ISEpD2VmK9"},{"type":"emphasis","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"same-position","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"K4Gh6n0Xcn"}],"key":"hjr5pemHN3"},{"type":"text","value":" path, but ","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"Oggq1ttlSH"},{"type":"strong","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"adjacent positions","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"vdodWcsbg2"}],"key":"VTt0MINqpx"},{"type":"text","value":" (a distance of a few positions) and ","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"GmXhI1h0kM"},{"type":"strong","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"the same substitution type","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"bgDCOaqKVB"}],"key":"q3iNF8TAOs"},{"type":"text","value":" are still in train. Write the paths that were not blocked in the report.","position":{"start":{"line":55,"co
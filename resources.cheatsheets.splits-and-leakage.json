lues(), key=len, reverse=True)\ntrain, test = [], []\nfor g in order:\n    (train if len(train) + len(g) <= 0.7 * len(smiles) else test).extend(g)\nassert train and test, \"목표 비율로 나눌 수 없으면 train/test가 비는 경우를 점검한다\"\nassert set(group[i] for i in train).isdisjoint(group[i] for i in test)\n\n# 누출을 숫자로: test 분자마다 train에서의 최근접 Tanimoto (ECFP4, 2048비트)\nfpgen = rdFingerprintGenerator.GetMorganGenerator(radius=2, fpSize=2048)    # ECFP4 (2048비트)\nfps = [fpgen.GetFingerprint(m) for m in mols]\nnn = [max(DataStructs.BulkTanimotoSimilarity(fps[j], [fps[i] for i in train])) for j in test]\nprint(\"그룹 수\", len(by_scaf), \"| train\", len(train), \"test\", len(test), f\"(test 비율 {len(test)/len(smiles):.2f})\", \"| test→train 최근접 Tanimoto 중앙값\", round(float(np.median(nn)), 2))\nassert len(nn) == len(test) and all(0.0 <= v <= 1.0 for v in nn)","position":{"start":{"line":83,"column":1},"end":{"line":113,"column":1}},"key":"XtwMCj4rkW"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":114,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"위 분할은 설명용 그리디 구현이다(큰 그룹부터 train을 채우고 나머지를 test로). 가장 큰 그룹이 목표 크기를 넘거나 그룹이 적으면 비율이 목표와 크게 달라지거나 train/test가 비므로 ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"t92GsQ4haC"},{"type":"strong","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"실제 비율을 보고","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"d3D1mhicE2"}],"key":"KrVv6KNiBH"},{"type":"text","value":"한다.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"cHwxG3IaCE"}],"key":"Q9FtKLI5Qj"}],"key":"fbLsbE7Fqb"},{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":
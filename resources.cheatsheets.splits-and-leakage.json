e":63,"column":1}},"key":"FBp3CGTIxX"},{"type":"code","lang":"python","value":"import io, pandas as pd\nfrom sklearn.model_selection import GroupShuffleSplit\n\n# clusterRes_cluster.tsv 형식의 합성 예시 (대표 \\t 구성원)\ntsv = \"A\\tA\\nA\\tB\\nA\\tC\\nD\\tD\\nD\\tE\\nF\\tF\\nG\\tG\\nG\\tH\\n\"\ncl = pd.read_csv(io.StringIO(tsv), sep=\"\\t\", header=None, names=[\"rep\", \"member\"])\nseq_ids = sorted(cl.member.unique())\ngroup_of = dict(zip(cl.member, cl.rep))\ngroups = np.array([group_of[s] for s in seq_ids])\ntr, te = GroupShuffleSplit(1, test_size=0.4, random_state=1).split(seq_ids, groups=groups).__next__()\nassert set(groups[tr]).isdisjoint(set(groups[te]))      # 같은 클러스터는 한쪽에만\nprint(\"train\", [seq_ids[i] for i in tr], \"| test\", [seq_ids[i] for i in te])","position":{"start":{"line":64,"column":1},"end":{"line":77,"column":1}},"key":"lTLt8PGKqn"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":78,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"--min-seq-id","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"OSYCvw0LUW"},{"type":"text","value":"가 ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"t9nFriqxHp"},{"type":"strong","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"낮을수록","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"CSfbDuYu9g"}],"key":"YjUPfligr1"},{"type":"text","value":"(예: 0.3 < 0.9) 큰 클러스터가 생겨 분할이 더 엄격하다. ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"zE4i7nCjxx"},{"type":"strong","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"임계값과 coverage 옵션(","position":{"start":{"line":78,"column":1},"end":{"line